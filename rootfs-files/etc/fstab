# Informer 701 (Allwinner A10 / N708H6) - Debian 12 (Bookworm) armhf
# 24/7 SD-card longevity: noatime + commit=60 on ext4, volatile tmpfs for /tmp, /var/tmp, /var/log
/dev/mmcblk0p2  /         ext4   rw,noatime,commit=60,errors=remount-ro            0 1
/dev/mmcblk0p1  /boot     vfat   rw,noatime,nofail                                 0 2
tmpfs           /tmp      tmpfs  defaults,noatime,nosuid,nodev,mode=1777,size=64M  0 0
tmpfs           /var/tmp  tmpfs  defaults,noatime,nosuid,nodev,mode=1777,size=32M  0 0
tmpfs           /var/log  tmpfs  defaults,noatime,nosuid,nodev,mode=0755,size=32M  0 0
