#!/bin/bash
# usbnet - USB-gadget-сеть и SSH на Informer 701 (N708H6, Allwinner A10, Debian 12 armhf)
#
# Порт micro-USB на плате - USB0 (OTG, musb-hdrc + configfs-gadget):
#   rndis - для Windows (встроенный драйвер, по умолчанию)
#   ecm   - для Linux/macOS (cdc_ether / CDC-ECM)
#   ncm   - для Windows 10+ / Linux (CDC-NCM)
# Поверх сети работает dropbear.service (SSH на 192.168.77.1:22) и dnsmasq (DHCP).
# Автозапуск и перезапуск при сбоях обеспечивает systemd-юнит
# informer701-usbnet.service (Restart=always).

CFG=/sys/kernel/config
GNAME=g1
G="$CFG/usb_gadget/$GNAME"
CONF=/etc/usbnet.conf
STATE=/run/usbnet.state
IFACES=/run/usbnet.ifaces

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH LC_NUMERIC=C

# ------------------------------------------------------------------- defaults
IP_MAIN=192.168.77.1
MASK_MAIN=24
IP_LL=169.254.77.1
MASK_LL=16
IP_MAIN2=192.168.78.1
DHCP_FIRST=20
DHCP_LAST=60
HOST_MAC=02:70:01:70:01:01
DEV_MAC=02:70:01:70:01:02
SSH_PORT=22
MODE_DEFAULT=rndis
ROOT_PASS_HINT=informer701

say()  { printf '%s\n' "$*"; }
ok()   { printf '[usbnet] %s\n' "$*"; }
warn() { printf '[usbnet] ВНИМАНИЕ: %s\n' "$*" >&2; }
die()  { printf '[usbnet] ОШИБКА: %s\n' "$*" >&2; exit 1; }

load_conf() {
    if [ ! -f "$CONF" ]; then
        cat > "$CONF" <<EOF
# /etc/usbnet.conf - настройки USB-сети (читает usbnet).
IP_MAIN=$IP_MAIN
MASK_MAIN=$MASK_MAIN
IP_MAIN2=$IP_MAIN2
IP_LL=$IP_LL
MASK_LL=$MASK_LL
DHCP_FIRST=$DHCP_FIRST
DHCP_LAST=$DHCP_LAST
HOST_MAC=$HOST_MAC
DEV_MAC=$DEV_MAC
SSH_PORT=$SSH_PORT
MODE_DEFAULT=$MODE_DEFAULT
GNAME=$GNAME
EOF
    fi
    # shellcheck disable=SC1090
    . "$CONF" 2>/dev/null || true
    G="$CFG/usb_gadget/$GNAME"
}

need_root() { [ "$(id -u)" -eq 0 ] || die "нужны права root"; }

have_udc() {
    UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
    [ -n "$UDC" ]
}

mount_configfs() {
    [ -d "$CFG/usb_gadget" ] && return 0
    mountpoint -q "$CFG" 2>/dev/null || mount -t configfs none "$CFG" 2>/dev/null
    [ -d "$CFG/usb_gadget" ] || die "configfs недоступен (CONFIGFS_FS в ядре?)"
}

has_systemd() { [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; }

# ------------------------------------------------------------------- SSH
ssh_keys() {
    need_root
    mkdir -p /etc/dropbear
    chmod 700 /etc/dropbear
    [ -x /usr/sbin/dropbear ] || [ -x /usr/bin/dropbear ] || die "dropbear не установлен"
    local DBK=/usr/bin/dropbearkey
    [ -x "$DBK" ] || DBK=/usr/sbin/dropbearkey
    for t in ed25519 ecdsa; do
        local f="/etc/dropbear/dropbear_${t}_host_key"
        if [ ! -s "$f" ]; then
            "$DBK" -t "$t" -f "$f" >/dev/null 2>&1 && ok "ключ хоста $t создан" \
                || warn "не удалось создать ключ $t"
        fi
    done
    local frsa=/etc/dropbear/dropbear_rsa_host_key
    if [ ! -s "$frsa" ]; then
        "$DBK" -t rsa -s 2048 -f "$frsa" >/dev/null 2>&1 && ok "ключ хоста rsa создан" \
            || warn "не удалось создать ключ rsa"
    fi
    chmod 600 /etc/dropbear/* 2>/dev/null || true
}

ssh_running() {
    if has_systemd && systemctl is-active --quiet dropbear.service 2>/dev/null; then
        return 0
    fi
    pgrep -x dropbear >/dev/null 2>&1
}

ssh_on() {
    need_root
    touch /etc/ssh-enabled
    mkdir -p /root/.ssh && chmod 700 /root/.ssh
    if ssh_running; then
        ok "dropbear уже работает (порт $SSH_PORT)"
        return 0
    fi
    [ -s /etc/dropbear/dropbear_ed25519_host_key ] || [ -s /etc/dropbear/dropbear_rsa_host_key ] || ssh_keys
    if has_systemd; then
        systemctl start dropbear.service 2>/dev/null || true
    else
        /usr/sbin/dropbear -R -P /run/dropbear.pid -p "$SSH_PORT" 2>/dev/null || true
    fi
    sleep 1
    if ssh_running; then
        ok "dropbear слушает порт $SSH_PORT"
    else
        warn "dropbear не запустился - проверьте journalctl -u dropbear.service"
        return 1
    fi
}

ssh_off() {
    need_root
    rm -f /etc/ssh-enabled
    if has_systemd; then
        systemctl stop dropbear.service 2>/dev/null || true
    fi
    [ -f /run/dropbear.pid ] && kill "$(cat /run/dropbear.pid)" 2>/dev/null || true
    rm -f /run/dropbear.pid
    killall dropbear 2>/dev/null || true
    ok "dropbear остановлен"
}

ssh_status() {
    if ssh_running; then
        local pid
        pid=$(pgrep -xo dropbear 2>/dev/null || echo "?")
        say "dropbear: работает (pid $pid), порт $SSH_PORT"
        ss -tln 2>/dev/null | grep -E ":${SSH_PORT}\b" | head -3 | sed 's/^/  /'
        say "активных подключений: $(ss -tn state established "( sport = :$SSH_PORT )" 2>/dev/null | tail -n +2 | wc -l)"
    else
        say "dropbear: остановлен  (запуск: usbnet ssh on)"
    fi
    [ -f /etc/ssh-enabled ] && say "автозапуск SSH: включён" || say "автозапуск SSH: выключен"
}

# --------------------------------------------------------------- гаджет
gadget_unbind() {
    [ -f "$G/UDC" ] || return 0
    local cur
    cur=$(cat "$G/UDC" 2>/dev/null || true)
    [ -n "$cur" ] && { echo "" > "$G/UDC" 2>/dev/null || true; sleep 1; }
}

gadget_remove() {
    gadget_unbind
    [ -d "$G" ] || return 0
    for l in "$G"/configs/c.1/*; do
        case "$l" in */strings|*/MaxPower) continue ;; esac
        [ -L "$l" ] && rm -f "$l"
    done
    [ -L "$G/os_desc/c.1" ] && rm -f "$G/os_desc/c.1"
    for d in "$G"/functions/*; do
        [ -d "$d" ] && rmdir "$d" 2>/dev/null || true
    done
    rmdir "$G/configs/c.1/strings/0x409" 2>/dev/null || true
    rmdir "$G/configs/c.1/strings" 2>/dev/null || true
    rmdir "$G/configs/c.1" 2>/dev/null || true
    rmdir "$G/strings/0x409" 2>/dev/null || true
    rmdir "$G/strings" 2>/dev/null || true
    rmdir "$G" 2>/dev/null || true
    rm -f "$STATE" "$IFACES"
}

mkfunc() {
    local t="$1" inst="$2"
    local d="$G/functions/$t.$inst"
    mkdir -p "$d" 2>/dev/null || { warn "не удалось создать функцию $t"; return 1; }
    case "$t" in
        rndis|ecm|ncm|eem)
            [ -f "$d/host_addr" ] && echo "$HOST_MAC" > "$d/host_addr" 2>/dev/null || true
            [ -f "$d/dev_addr" ]  && echo "$DEV_MAC"  > "$d/dev_addr"  2>/dev/null || true
            ;;
    esac
    if [ "$t" = rndis ]; then
        local i="$d/os_desc/interface.rndis"
        if [ -d "$i" ]; then
            echo RNDIS   > "$i/compatible_id"     2>/dev/null || true
            echo 5162001 > "$i/sub_compatible_id" 2>/dev/null || true
        fi
    fi
    ln -s "$d" "$G/configs/c.1/" 2>/dev/null || { warn "не привязал $t.$inst к c.1"; return 1; }
    return 0
}

is_gadget_iface() {
    local _n="$1"
    [ -e "/sys/class/net/$_n" ] || return 1
    local _d
    _d=$(readlink -f "/sys/class/net/$_n/device" 2>/dev/null || true)
    [ -n "$_d" ] || return 0
    local _b="${_d##*/}"
    case "$_b" in gadget*) return 0 ;; esac
    case "$_d" in *"$UDC"*) return 0 ;; esac
    [ -e "$_d/bInterfaceNumber" ] && return 1
    local _p
    _p=$(readlink -f "$_d/.." 2>/dev/null || true)
    if [ -n "$_p" ] && [ -e "$_p/busnum" ] && [ -e "$_p/idVendor" ]; then return 1; fi
    return 0
}

net_up() {
    local iface="$1" ipm="$2" mask="$3" ipl="$4" maskl="$5"
    ip link set "$iface" up 2>/dev/null || warn "ip link set $iface up не сработал"
    ip addr flush dev "$iface" 2>/dev/null || true
    ip addr add "$ipm/$mask" dev "$iface" 2>/dev/null || true
    [ -n "$ipl" ] && ip addr add "$ipl/$maskl" dev "$iface" 2>/dev/null || true
    ip link set "$iface" mtu 1500 2>/dev/null || true
    if [ -n "$ipl" ]; then
        ok "$iface = $ipm/$mask (+ $ipl/$maskl)"
    else
        ok "$iface = $ipm/$mask"
    fi
}

# DHCP-сервер на интерфейсе гаджета через стандартный dnsmasq (Debian dnsmasq-base).
# --port=0 отключает DNS, пустые опции 3 и 6 гарантируют, что ПК НЕ переключит
# свой маршрут по умолчанию и DNS на плату (интернет на ПК не пропадёт).
dhcp_on() {
    local iface="$1" ipm="$2"
    command -v dnsmasq >/dev/null 2>&1 || { warn "dnsmasq не установлен - ПК получит APIPA"; return 0; }
    local pidf="/run/dnsmasq-usb-$iface.pid"
    local leasef="/run/dnsmasq-usb-$iface.leases"
    local base="${ipm%.*}"
    [ -f "$pidf" ] && kill "$(cat "$pidf" 2>/dev/null)" 2>/dev/null || true
    rm -f "$pidf"
    if dnsmasq --port=0 \
        --interface="$iface" \
        --except-interface=lo \
        --bind-dynamic \
        --dhcp-range="$base.$DHCP_FIRST,$base.$DHCP_LAST,255.255.255.0,24h" \
        --dhcp-option=3 \
        --dhcp-option=6 \
        --dhcp-leasefile="$leasef" \
        --pid-file="$pidf" 2>/dev/null; then
        ok "DHCP (dnsmasq) на $iface: $base.$DHCP_FIRST-$base.$DHCP_LAST"
    else
        warn "dnsmasq не запустился на $iface"
    fi
}

dhcp_off() {
    for pf in /run/dnsmasq-usb-*.pid; do
        [ -e "$pf" ] || continue
        kill "$(cat "$pf" 2>/dev/null)" 2>/dev/null || true
        rm -f "$pf"
    done
    rm -f /run/dnsmasq-usb-*.leases
}

serial_on() {
    [ -e /dev/ttyGS0 ] || { warn "/dev/ttyGS0 нет - ACM не поднялся"; return 0; }
    if has_systemd; then
        mkdir -p /etc/systemd/system/serial-getty@ttyGS0.service.d
        cat > /etc/systemd/system/serial-getty@ttyGS0.service.d/override.conf <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin root --keep-baud 115200,38400,9600 %I $TERM
Restart=always
RestartSec=1
EOF
        systemctl daemon-reload 2>/dev/null || true
        systemctl start serial-getty@ttyGS0.service 2>/dev/null || true
    else
        [ -f /run/ttyGS0.pid ] && kill "$(cat /run/ttyGS0.pid)" 2>/dev/null || true
        setsid /sbin/agetty --autologin root 115200 ttyGS0 vt102 >/dev/null 2>&1 &
        echo "$!" > /run/ttyGS0.pid
    fi
    ok "консоль в /dev/ttyGS0: на ПК появится COM-порт (115200, вход без пароля)"
}

serial_off() {
    if has_systemd; then
        systemctl stop serial-getty@ttyGS0.service 2>/dev/null || true
    fi
    [ -f /run/ttyGS0.pid ] && { kill "$(cat /run/ttyGS0.pid)" 2>/dev/null || true; rm -f /run/ttyGS0.pid; }
}

gadget_on() {
    need_root
    local mode="${1:-$MODE_DEFAULT}"
    have_udc || die "нет UDC в /sys/class/udc - узел usb_otg выключен в этом DTB (проверьте 'usbnet test')"
    mount_configfs
    dhcp_off
    gadget_remove
    mkdir -p "$G" || die "не создался $G"
    cd "$G" || die "нет $G"

    echo 0x1d6b > idVendor
    echo 0x0104 > idProduct
    echo 0x0200 > bcdUSB
    echo 0x0100 > bcdDevice
    mkdir -p strings/0x409
    echo "0000-informer701"        > strings/0x409/serialnumber
    echo "Informer 701 (A10)"      > strings/0x409/manufacturer
    echo "USB network gadget"      > strings/0x409/product
    mkdir -p configs/c.1/strings/0x409
    echo "$mode"                   > configs/c.1/strings/0x409/configuration
    echo 250                       > configs/c.1/MaxPower

    echo 1       > os_desc/use             2>/dev/null || true
    echo 0xbc    > os_desc/b_vendor_code   2>/dev/null || true
    echo MSFT100 > os_desc/qw_sign         2>/dev/null || true

    local want_ser=0
    case "$mode" in
        rndis)  mkfunc rndis usb0 ;;
        ecm)    mkfunc ecm   usb0 ;;
        ncm)    mkfunc ncm   usb0 ;;
        both)   mkfunc rndis usb0; mkfunc ecm usb0 ;;
        ser)    mkfunc rndis usb0; want_ser=1 ;;
        all)    mkfunc rndis usb0; mkfunc ecm usb0; want_ser=1 ;;
        *)      die "неизвестный режим '$mode' (rndis|ecm|ncm|both|ser|all)" ;;
    esac
    if [ "$want_ser" = 1 ]; then
        mkdir -p "$G/functions/acm.GS0" 2>/dev/null \
            && ln -s "$G/functions/acm.GS0" "$G/configs/c.1/" 2>/dev/null \
            || warn "не удалось добавить ACM"
    fi

    ln -s "$G/configs/c.1" "$G/os_desc" 2>/dev/null || true
    echo "$UDC" > UDC || die "не удалось привязать гаджет к $UDC"
    sleep 2

    : > "$IFACES"
    local try=0
    while [ "$try" -lt 5 ]; do
        : > "$IFACES"
        for n in /sys/class/net/usb*; do
            [ -e "$n" ] || continue
            is_gadget_iface "$(basename "$n")" || continue
            basename "$n" >> "$IFACES"
        done
        [ -s "$IFACES" ] && break
        try=$((try+1)); sleep 1
    done
    local iface
    iface=$(head -1 "$IFACES" 2>/dev/null || true)
    [ -n "$iface" ] || die "гаджет привязан, но сетевой интерфейс не появился"
    local nf
    nf=$(wc -l < "$IFACES")
    case "$mode" in
        both|all) [ "$nf" -ge 2 ] || warn "ожидалось 2 интерфейса (rndis+ecm), нашлось $nf" ;;
    esac
    echo "mode $mode iface $iface udc $UDC" > "$STATE"

    local idx=0
    while IFS= read -r i; do
        [ -n "$i" ] || continue
        if [ "$idx" -eq 0 ]; then
            net_up "$i" "$IP_MAIN"  "$MASK_MAIN" "$IP_LL" "$MASK_LL"
            dhcp_on "$i" "$IP_MAIN"
        else
            net_up "$i" "$IP_MAIN2" "$MASK_MAIN" "" ""
            dhcp_on "$i" "$IP_MAIN2"
        fi
        idx=$((idx+1))
    done < "$IFACES"

    [ "$want_ser" = 1 ] && serial_on
    ssh_on || true
    ok "гаджет '$mode' поднят на $UDC, интерфейс $iface"
    conn_info
}

gadget_off() {
    need_root
    load_conf
    serial_off
    dhcp_off
    if [ -d "$G" ]; then
        gadget_remove
        ok "гаджет снят"
    else
        ok "гаджет не был создан"
    fi
    if [ -f "$IFACES" ]; then
        local t=0
        while [ "$t" -lt 5 ]; do
            local left=0
            while IFS= read -r i; do
                [ -e "/sys/class/net/$i" ] && left=1
            done < "$IFACES"
            [ "$left" = 0 ] && break
            t=$((t+1)); sleep 1
        done
        while IFS= read -r i; do
            ip link set "$i" down 2>/dev/null || true
        done < "$IFACES"
        rm -f "$IFACES"
    fi
    rm -f "$STATE"
}

# Проверка условий автозапуска для ExecCondition в informer701-usbnet.service.
# Код 1..254 в ExecCondition означает "штатно пропустить юнит без ошибки"
# (например, при usbnet=0, при выключенном автозапуске или в QEMU без musb UDC).
check_autostart() {
    load_conf
    local cmdline
    cmdline=$(cat /proc/cmdline 2>/dev/null || true)
    local want=0
    [ -f /etc/usbnet-enabled ] && want=1
    case "$cmdline" in *usbnet=1*) want=1 ;; esac
    case "$cmdline" in *usbnet=0*|*nousb=1*) want=0 ;; esac
    [ "$want" = 1 ] || return 1

    # Ждём инициализации UDC до 6 с (после probe musb)
    local w=0
    while [ "$w" -lt 6 ]; do
        if have_udc; then return 0; fi
        sleep 1
        w=$((w+1))
    done
    say "[usbnet] аппаратный UDC не обнаружен (/sys/class/udc пуст) - автозапуск гаджета пропущен"
    return 1
}

# Режим демона для systemd (Restart=always): поднимает usb0 (192.168.77.1) и
# следит за целостностью интерфейса/IP/DHCP каждые 5 с.
daemon_loop() {
    need_root
    load_conf
    trap 'gadget_off; exit 0' TERM INT
    gadget_on "${1:-$MODE_DEFAULT}"
    local iface
    iface=$(gadget_iface || echo "usb0")
    while :; do
        sleep 5
        [ -e "/sys/class/net/$iface" ] || die "интерфейс $iface исчез - перезапуск службы"
        # Если в режиме usbnet nat (клиент DHCP) - адрес контролирует dhclient
        if [ ! -f /run/usbnet-nat.info ]; then
            if ! ip -4 -o addr show dev "$iface" 2>/dev/null | grep -qF "$IP_MAIN/"; then
                warn "адрес $IP_MAIN пропал с $iface - восстанавливаю"
                net_up "$iface" "$IP_MAIN" "$MASK_MAIN" "$IP_LL" "$MASK_LL"
            fi
            local pidf="/run/dnsmasq-usb-$iface.pid"
            if command -v dnsmasq >/dev/null 2>&1 && [ -f "$pidf" ]; then
                kill -0 "$(cat "$pidf" 2>/dev/null)" 2>/dev/null || die "dnsmasq на $iface завершился - перезапуск"
            fi
        fi
    done
}

# ------------------------------------------------------------------- инфо
conn_info() {
    say ""
    say "Подключение с ПК (тот же micro-USB кабель):"
    say "    ssh root@$IP_MAIN        пароль: $ROOT_PASS_HINT"
    say "    scp файл root@$IP_MAIN:/root/"
    say "Запасной адрес (link-local APIPA): ssh root@$IP_LL"
    say ""
}

status() {
    load_conf
    say "=== ядро / система ==="
    say "uname:   $(uname -r)"
    [ -f /etc/build-id ] && say "сборка:  $(cat /etc/build-id)"
    say ""
    say "=== USB (роль и состояние) ==="
    if have_udc; then
        say "UDC:     $UDC"
        local st
        st=$(cat "/sys/class/udc/$UDC/state" 2>/dev/null || true)
        say "state:   ${st:-неизвестно}"
        [ -f "/sys/class/udc/$UDC/current_speed" ] && \
            say "скорость: $(cat "/sys/class/udc/$UDC/current_speed")"
    else
        say "UDC:     НЕТ - узел usb_otg выключён в текущем DTB (см. 'usbnet test')"
    fi
    for e in /sys/class/extcon/extcon*/state; do
        [ -e "$e" ] || continue
        say "extcon:  $(cat "$e" 2>/dev/null)"
    done
    say ""
    say "=== гаджет ==="
    if [ -f "$STATE" ]; then
        say "$(cat "$STATE")"
        say "UDC в гаджете: $(cat "$G/UDC" 2>/dev/null || true)"
    else
        say "не поднят (usbnet on)"
    fi
    say ""
    say "=== сеть ==="
    ip -o addr 2>/dev/null | awk '{print "  " $2 " " $4}'
    ip route 2>/dev/null | grep '^default' | sed 's/^/  маршрут: /' || true
    say ""
    say "=== DHCP-сервер (dnsmasq) ==="
    local any=0
    for pf in /run/dnsmasq-usb-*.pid; do
        [ -e "$pf" ] || continue
        local pid
        pid=$(cat "$pf" 2>/dev/null || true)
        [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || continue
        any=1
        local ifn
        ifn=$(basename "$pf" .pid | sed 's/^dnsmasq-usb-//')
        say "dnsmasq работает (pid $pid, интерфейс $ifn)"
        local lf="/run/dnsmasq-usb-$ifn.leases"
        [ -s "$lf" ] && head -5 "$lf" | sed 's/^/    /'
    done
    [ "$any" = 1 ] || say "DHCP-сервер на USB не запущен"
    say ""
    say "=== SSH ==="
    ssh_status
    say ""
    say "=== USB-хост (площадка USB2 / WiFi) ==="
    local n
    n=$(ls -d /sys/bus/usb/devices/*/ 2>/dev/null | wc -l)
    say "устройств на шине: ${n:-0}"
    host_list
}

host_list() {
    for d in /sys/bus/usb/devices/*; do
        [ -e "$d/idVendor" ] || continue
        local b v p prod man
        b=$(basename "$d")
        v=$(cat "$d/idVendor" 2>/dev/null || true)
        p=$(cat "$d/idProduct" 2>/dev/null || true)
        prod=$(cat "$d/product" 2>/dev/null || true)
        man=$(cat "$d/manufacturer" 2>/dev/null || true)
        say "  $b  $v:$p  ${prod:-?} ${man:+($man)}"
    done
}

dhcp_client_stop() {
    local ifc="$1"
    if [ -f "/run/dhclient-$ifc.pid" ]; then
        dhclient -4 -r -pf "/run/dhclient-$ifc.pid" -lf "/run/dhclient-$ifc.leases" "$ifc" >/dev/null 2>&1 || true
        kill "$(cat "/run/dhclient-$ifc.pid" 2>/dev/null)" 2>/dev/null || true
        rm -f "/run/dhclient-$ifc.pid"
    fi
}

dhcp_client_up() {
    local ifc="$1"
    dhcp_client_stop "$ifc"
    ip link set "$ifc" up 2>/dev/null || true
    dhclient -4 -1 -pf "/run/dhclient-$ifc.pid" -lf "/run/dhclient-$ifc.leases" "$ifc" >/dev/null 2>&1
}

# ------------------------------------------------------- USB-Ethernet адаптер
eth_up() {
    need_root
    load_conf
    local found=0
    for i in /sys/class/net/*; do
        [ -e "$i" ] || continue
        local n
        n=$(basename "$i")
        [ "$n" = lo ] && continue
        if [ -f "$IFACES" ] && grep -qx "$n" "$IFACES" 2>/dev/null; then continue; fi
        [ -e "$i/device" ] || continue
        case "$(readlink -f "$i/device" 2>/dev/null || true)" in
            */usb*) ;;
            *) continue ;;
        esac
        found=1
        say "  поднимаю $n (dhclient)..."
        if timeout 20 bash -c "ip link set '$n' up && dhclient -4 -1 -pf '/run/dhclient-$n.pid' -lf '/run/dhclient-$n.leases' '$n'" 2>/dev/null; then
            ip -o -4 addr show dev "$n" 2>/dev/null | awk '{print "    " $2 " = " $4}'
            say "    шлюз: $(ip route 2>/dev/null | awk '/^default/ {print $3; exit}')"
        else
            say "    DHCP не ответил (кабель вставлен? линк есть?)"
        fi
    done
    [ "$found" = 1 ] || say "USB-Ethernet адаптер не найден (см. 'usbnet host')"
    ssh_running || ssh_on || true
}

gadget_iface() {
    if [ -f "$IFACES" ] && [ -s "$IFACES" ]; then head -1 "$IFACES"; return 0; fi
    for i in /sys/class/net/*; do
        [ -e "$i" ] || continue
        local n
        n=$(basename "$i")
        [ "$n" = lo ] && continue
        is_gadget_iface "$n" && { echo "$n"; return 0; }
    done
    return 1
}

# ------------------------------------------- интернет с ПК по USB (usbnet nat)
nat_on() {
    need_root; load_conf
    local ifc
    ifc=$(gadget_iface) || die "нет интерфейса гаджета - сначала 'usbnet on'"
    ok "NAT через ПК: интерфейс $ifc"
    dhcp_off
    say "  DHCP-сервер платы остановлен (адрес раздаёт ПК / ICS)"
    : > /run/usbnet-nat.info
    ip addr flush dev "$ifc" 2>/dev/null || true
    if timeout 25 bash -c "ip link set '$ifc' up && dhclient -4 -1 -pf '/run/dhclient-$ifc.pid' -lf '/run/dhclient-$ifc.leases' '$ifc'" 2>/dev/null; then
        local addr gw
        addr=$(ip -4 -o addr show dev "$ifc" 2>/dev/null | awk '{print $4}' | head -1)
        gw=$(ip route 2>/dev/null | awk '/^default/ {print $3; exit}')
        echo "$addr gw=${gw:-нет}" > /run/usbnet-nat.info
        ok "$ifc = ${addr:-?}  шлюз ${gw:-?}"
        ip addr add "$IP_LL/$MASK_LL" dev "$ifc" 2>/dev/null || true
        grep -h '^nameserver' /etc/resolv.conf 2>/dev/null | sed 's/^/  /'
        if ping -c1 -W3 1.1.1.1 >/dev/null 2>&1; then
            say "  интернет (1.1.1.1): ОК"
            ping -c1 -W3 deb.debian.org >/dev/null 2>&1 \
                && say "  DNS (deb.debian.org): ОК" \
                || say "  DNS не работает - проверьте /etc/resolv.conf"
        fi
        ok "теперь доступно: pkg time && pkg update && pkg add <имя>"
        ok "ssh на плату: ssh root@${addr%%/*}   (или ssh root@$IP_LL)"
    else
        rm -f /run/usbnet-nat.info
        warn "DHCP от ПК не получен - возвращаю статический адрес $IP_MAIN/$MASK_MAIN"
        net_up "$ifc" "$IP_MAIN" "$MASK_MAIN" "$IP_LL" "$MASK_LL"
        dhcp_on "$ifc" "$IP_MAIN"
    fi
    ssh_running || ssh_on || true
}

nat_off() {
    need_root; load_conf
    local ifc
    ifc=$(gadget_iface) || die "нет интерфейса гаджета"
    dhcp_client_stop "$ifc"
    ip route del default dev "$ifc" 2>/dev/null || true
    rm -f /run/usbnet-nat.info
    net_up "$ifc" "$IP_MAIN" "$MASK_MAIN" "$IP_LL" "$MASK_LL"
    dhcp_on "$ifc" "$IP_MAIN"
    ok "возврат к штатной схеме: плата $IP_MAIN/$MASK_MAIN, ssh root@$IP_MAIN"
    ssh_running || ssh_on || true
}

mount_usb() {
    need_root
    local found=0
    for b in /sys/block/sd*; do
        [ -e "$b" ] || continue
        local dev="/dev/$(basename "$b")"
        for p in "${dev}"*[0-9] "$dev"; do
            [ -b "$p" ] || continue
            local mp="/mnt/$(basename "$p")"
            mountpoint -q "$mp" 2>/dev/null && continue
            mkdir -p "$mp"
            if mount "$p" "$mp" 2>/dev/null; then
                say "  $p -> $mp"
                ls "$mp" | head -8 | sed 's/^/     /'
                found=1
            else
                rmdir "$mp" 2>/dev/null || true
            fi
        done
    done
    [ "$found" = 1 ] || say "съёмных USB-носителей не найдено (см. 'usbnet host')"
}

auto_set() {
    need_root
    case "${1:-status}" in
        on)
            touch /etc/usbnet-enabled /etc/ssh-enabled
            if has_systemd; then
                systemctl enable informer701-usbnet.service dropbear.service >/dev/null 2>&1 || true
            fi
            ok "автозапуск включён: при загрузке поднимается гаджет ($MODE_DEFAULT, $IP_MAIN) и SSH"
            ;;
        off)
            rm -f /etc/usbnet-enabled /etc/ssh-enabled
            if has_systemd; then
                systemctl disable informer701-usbnet.service dropbear.service >/dev/null 2>&1 || true
            fi
            ok "автозапуск выключен (поднять вручную: usbnet on)"
            ;;
        *)
            [ -f /etc/usbnet-enabled ] && say "автозапуск гаджета: ВКЛЮЧЁН" || say "автозапуск гаджета: выключен"
            [ -f /etc/ssh-enabled ] && say "автозапуск SSH:     ВКЛЮЧЁН" || say "автозапуск SSH:     выключен"
            ;;
    esac
}

selftest() {
    load_conf
    say "=== диагностика USB-gadget ==="
    printf '%-34s %s\n' "ядро" "$(uname -r)"
    printf '%-34s %s\n' "/sys/class/udc" "$(ls /sys/class/udc 2>/dev/null | tr '\n' ' ')"
    if have_udc; then
        local drv
        drv=$(readlink -f "/sys/class/udc/$UDC/device/driver" 2>/dev/null || true)
        printf '%-34s %s\n' "драйвер UDC" "${drv:-?}"
    fi
    printf '%-34s %s\n' "configfs" "$([ -d "$CFG/usb_gadget" ] && echo 'смонтирован' || echo 'не смонтирован (usbnet сделает сам)')"
    mount_configfs 2>/dev/null || true
    printf '%-34s %s\n' "configfs после монтирования" "$([ -d "$CFG/usb_gadget" ] && echo ok || echo НЕТ)"
    say ""
    say "Проверка поддержки функций (создаём временный гаджет):"
    local tmp="$CFG/usb_gadget/__test"
    mkdir -p "$tmp/functions" 2>/dev/null || true
    for f in rndis ecm ncm eem acm mass_storage ffs serial; do
        if mkdir -p "$tmp/functions/$f.t" 2>/dev/null; then
            printf '  %-14s ПОДДЕРЖИВАЕТСЯ\n' "$f"
            rmdir "$tmp/functions/$f.t" 2>/dev/null || true
        else
            printf '  %-14s нет\n' "$f"
        fi
    done
    rmdir "$tmp/functions" "$tmp" 2>/dev/null || true
    say ""
    say "extcon (роль OTG):"
    for e in /sys/class/extcon/extcon*/state; do
        [ -e "$e" ] || continue
        say "  $(cat "$e")"
    done
    say ""
    say "USB-хост (EHCI/OHCI):"
    for h in /sys/bus/platform/drivers/*ehci* /sys/bus/platform/drivers/*ohci*; do
        [ -d "$h" ] || continue
        say "  $(basename "$h"): $(ls "$h" 2>/dev/null | grep -vE '^bind$|^unbind$|^module$|^uevent$|\.(drv|link)$' | tr '\n' ' ')"
    done
    say ""
    say "dmesg (usb/musb/gadget):"
    dmesg 2>/dev/null | grep -iE 'musb|gadget|usb|ehci|ohci|phy' | tail -20 | sed 's/^/  /'
}

show_log() {
    dmesg 2>/dev/null | grep -iE 'musb|gadget|configfs|rndis|ecm|usb0|udc' | tail -40
}

usage() {
    cat <<EOF
usbnet - USB-gadget-сеть и SSH на Informer 701 (Debian 12 Bookworm armhf)

Микро-USB порт платы = USB0 (OTG). Плата поднимает USB-сетевой интерфейс
($IP_MAIN/$MASK_MAIN + $IP_LL/$MASK_LL), DHCP-сервер (dnsmasq) и SSH (dropbear).

Команды:
  usbnet on [rndis|ecm|ncm|both|ser|all]   поднять гаджет (по умолчанию rndis)
  usbnet off                               снять гаджет и остановить DHCP
  usbnet status                            состояние UDC, сети, DHCP и SSH
  usbnet conn                              строка подключения по SSH с ПК
  usbnet ssh on|off|status|keys            управление SSH-сервером dropbear
  usbnet eth                               получить адрес по DHCP на USB-Ethernet
  usbnet nat [on|off|status]               интернет на плату с ПК по USB (ICS)
  usbnet host                              список устройств на USB-хосте
  usbnet mount                             смонтировать USB-накопитель в /mnt/
  usbnet auto on|off|status                автозапуск через systemd при загрузке
  usbnet test                              диагностика configfs/UDC в ядре
  usbnet log                               сообщения USB/gadget из dmesg

Вход с ПК: ssh root@$IP_MAIN   (пароль: $ROOT_PASS_HINT)
EOF
}

load_conf
cmd="${1:-help}"
shift 2>/dev/null || true
case "$cmd" in
    on)              gadget_on "$@" ;;
    off)             gadget_off ;;
    daemon)          daemon_loop "$@" ;;
    check-autostart) check_autostart ;;
    status|st)       status ;;
    conn|ip)         conn_info ;;
    ssh)
        case "${1:-status}" in
            on)   ssh_on ;;
            off)  ssh_off ;;
            keys) ssh_keys ;;
            *)    ssh_status ;;
        esac ;;
    eth)             eth_up ;;
    nat)
        case "${1:-on}" in
            off)    nat_off ;;
            status) say "NAT: $(cat /run/usbnet-nat.info 2>/dev/null || echo 'не включён (usbnet nat)')"
                    say "шлюз: $(ip route 2>/dev/null | awk '/^default/{print $3; exit}')"
                    say "DNS:  $(grep -h '^nameserver' /etc/resolv.conf 2>/dev/null | tr '\n' ' ')" ;;
            *)      nat_on ;;
        esac ;;
    host)            load_conf; say "=== USB-хост ==="; host_list; say "блоки:"; ls /sys/block 2>/dev/null | tr '\n' ' '; say "" ;;
    mount)           mount_usb ;;
    auto)            auto_set "${1:-status}" ;;
    test|diag)       selftest ;;
    log)             show_log ;;
    help|-h|--help|"") usage ;;
    *)               usage; exit 1 ;;
esac
