#!/bin/bash
# pkg - управление пакетами Debian 12 (Bookworm, armhf) на Informer 701
#
# Обёртка над стандартными apt-get / apt-cache / dpkg с учётом особенностей платы:
#   * батарейки RTC нет -> проверка системного времени перед HTTPS/GPG и команда
#     `pkg time` (синхронизация по NTP или заголовку HTTP Date);
#   * диагностика сети/DNS/зеркал (`pkg net`);
#   * офлайновая установка локальных пакетов `.deb` из `/boot/deb` на vFAT-разделе
#     SD-карты (`pkg local`);
#   * автоматическая очистка кэша apt, чтобы не раздувать корневой раздел и не
#     изнашивать SD-карту.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH LC_NUMERIC=C

DEBDIR=/boot/deb
BAKED=/etc/informer701-packages.txt
SOURCES=/etc/apt/sources.list
MIRROR_HTTP=http://deb.debian.org/debian
MIRROR_HTTPS=https://deb.debian.org/debian
SEC_HTTP=http://deb.debian.org/debian-security
SEC_HTTPS=https://deb.debian.org/debian-security

say()  { printf '%s\n' "$*"; }
ok()   { printf '[pkg] %s\n' "$*"; }
warn() { printf '[pkg] ВНИМАНИЕ: %s\n' "$*" >&2; }
die()  { printf '[pkg] ОШИБКА: %s\n' "$*" >&2; exit 1; }
need_root() { [ "$(id -u)" -eq 0 ] || die "нужны права root"; }

have_apt() { command -v apt-get >/dev/null 2>&1 || die "apt-get не найден"; }

year_now() { date -u +%Y 2>/dev/null; }

time_bad() {
    local y
    y=$(year_now)
    case "$y" in
        ""|19[0-9][0-9]|20[0-1][0-9]|202[0-2]) return 0 ;;
        *) return 1 ;;
    esac
}

check_time() {
    if time_bad; then
        warn "системное время $(date -u '+%Y-%m-%d %H:%M') выглядит сброшенным (RTC без батарейки)."
        say "    Проверка подписей репозитория Debian и HTTPS требуют актуальной даты:"
        say "      pkg time        - получить точное время из интернета (NTP / HTTP Date)"
        say "      date -u -s '2026-11-26 12:00:00'   - выставить вручную"
        return 1
    fi
    return 0
}

net_hint() {
    local ifc
    ifc=$(ip route 2>/dev/null | awk '/^default/{print $5; exit}')
    if [ -z "$ifc" ]; then
        warn "нет маршрута по умолчанию - интернета нет."
        say "    wifi connect <SSID> <пароль>   - через USB-WiFi адаптер"
        say "    usbnet nat                     - через ПК по micro-USB кабелю"
        say "    usbnet eth                     - через USB-Ethernet адаптер"
        return 1
    fi
    return 0
}

save_fake_hwclock() {
    if command -v fake-hwclock >/dev/null 2>&1; then
        fake-hwclock save >/dev/null 2>&1 || true
    fi
}

cmd_time() {
    need_root
    ok "пытаюсь получить точное время из интернета..."
    net_hint || true

    if command -v ntpdate >/dev/null 2>&1; then
        for s in pool.ntp.org 0.debian.pool.ntp.org time.google.com; do
            if ntpdate -u "$s" >/dev/null 2>&1; then
                ok "время получено по NTP ($s): $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
                hwclock -w 2>/dev/null || true
                save_fake_hwclock
                return 0
            fi
        done
        warn "NTP не ответил (порт UDP 123 закрыт? пробую HTTP Date...)"
    fi

    local u h ds iso
    for u in "$MIRROR_HTTP/" "http://www.google.com/" "$MIRROR_HTTPS/"; do
        if command -v curl >/dev/null 2>&1; then
            h=$(curl -ksI --max-time 10 "$u" 2>/dev/null | grep -i '^Date:' | tail -1 | tr -d '\r')
        else
            h=$(wget -S --spider --timeout=10 "$u" 2>&1 | grep -i '^ *Date:' | tail -1 | tr -d '\r')
        fi
        [ -n "$h" ] || continue
        ds=$(echo "$h" | sed -E 's/^[[:space:]]*[Dd]ate:[[:space:]]*//; s/^[A-Za-z]{3},[[:space:]]*//; s/[[:space:]]*GMT$//')
        iso=$(echo "$ds" | awk '{
            m["Jan"]="01";m["Feb"]="02";m["Mar"]="03";m["Apr"]="04";m["May"]="05";m["Jun"]="06";
            m["Jul"]="07";m["Aug"]="08";m["Sep"]="09";m["Oct"]="10";m["Nov"]="11";m["Dec"]="12";
            if (m[$2] != "") printf "%s-%s-%02d %s", $3, m[$2], $1, $4
        }')
        if [ -n "$iso" ] && date -u -s "$iso" >/dev/null 2>&1; then
            ok "время установлено из HTTP-заголовка ($u): $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
            hwclock -w 2>/dev/null || true
            save_fake_hwclock
            return 0
        fi
    done

    warn "время получить не удалось. Установите вручную:"
    say "    date -u -s '2026-11-26 12:00:00'"
    return 1
}

write_sources() {
    local proto="$1"
    local m="$MIRROR_HTTP" s="$SEC_HTTP"
    if [ "$proto" = "https" ]; then
        m="$MIRROR_HTTPS"
        s="$SEC_HTTPS"
    fi
    cat > "$SOURCES" <<EOF
deb $m bookworm main contrib non-free-firmware
deb $m bookworm-updates main contrib non-free-firmware
deb $s bookworm-security main contrib non-free-firmware
EOF
}

cmd_repo() {
    case "${1:-show}" in
        show|"")
            say "репозитории Debian ($SOURCES):"
            [ -f "$SOURCES" ] && sed 's/^/  /' "$SOURCES"
            ;;
        http)
            need_root
            write_sources http
            ok "зеркала переведены на http (пакеты проверяются GPG-ключами Debian)"
            sed 's/^/  /' "$SOURCES"
            ;;
        https)
            need_root
            write_sources https
            ok "зеркала переведены на https (требуется точное время: pkg time)"
            sed 's/^/  /' "$SOURCES"
            ;;
        *)
            say "использование: pkg repo [show|http|https]"
            return 1
            ;;
    esac
}

cmd_update() {
    need_root; have_apt
    check_time || true
    net_hint || true
    ok "apt-get update ..."
    if DEBIAN_FRONTEND=noninteractive apt-get update; then
        ok "индекс пакетов Debian 12 (bookworm armhf) обновлён"
        say "  поиск:     pkg search <строка>"
        say "  установка: pkg add <имя>"
    else
        warn "apt-get update завершился с ошибкой."
        check_time || true
        say "    диагностика: pkg net"
        return 1
    fi
}

cmd_add() {
    need_root; have_apt
    [ $# -gt 0 ] || { say "использование: pkg add <пакет> [пакет...]"; return 1; }
    check_time || true
    if [ -z "$(ls -A /var/lib/apt/lists 2>/dev/null | grep -vE '^lock$|^partial$' || true)" ]; then
        ok "локальный индекс apt пуст - выполняю apt-get update..."
        DEBIAN_FRONTEND=noninteractive apt-get update || warn "не удалось обновить индекс apt"
    fi
    ok "apt-get install $*"
    if DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$@"; then
        apt-get clean >/dev/null 2>&1 || true
        ok "установлено: $*"
        return 0
    fi
    warn "apt-get install вернул ошибку"
    return 1
}

cmd_del() {
    need_root; have_apt
    [ $# -gt 0 ] || { say "использование: pkg del <пакет> [пакет...]"; return 1; }
    ok "apt-get remove $*"
    DEBIAN_FRONTEND=noninteractive apt-get remove -y "$@"
}

cmd_search() {
    have_apt
    [ $# -gt 0 ] || {
        say "использование: pkg search <строка>"
        say "например: pkg search python3  |  pkg search tcpdump"
        return 1
    }
    if ! apt-cache search "$@" 2>/dev/null | head -40 | grep -q .; then
        warn "ничего не найдено или индекс apt пуст (выполните: pkg update)"
        return 1
    fi
    apt-cache search "$@" 2>/dev/null | head -40
    say ""
    say "подробнее о пакете: pkg info <имя>"
}

cmd_info() {
    [ -n "${1:-}" ] || { say "использование: pkg info <пакет>"; return 1; }
    dpkg -s "$1" 2>/dev/null || apt-cache show "$1" 2>/dev/null | head -35 || {
        warn "пакет '$1' не найден (попробуйте сначала pkg update)"
        return 1
    }
}

cmd_deps() {
    have_apt
    [ $# -gt 0 ] || { say "использование: pkg deps <пакет>   (симуляция установки)"; return 1; }
    apt-get install -s --no-install-recommends "$@" 2>&1 | head -35
}

cmd_list() {
    local cnt
    cnt=$(dpkg-query -W -f='${Package}\n' 2>/dev/null | wc -l)
    say "=== установлено в системе dpkg ($cnt пакетов Debian armhf) ==="
    dpkg-query -W -f='  ${Package} ${Version}\n' 2>/dev/null | sort | head -60
    [ "$cnt" -gt 60 ] && say "  ... (всего $cnt пакетов; полный список: dpkg -l)"
    say ""
    say "занято на /: $(df -h / 2>/dev/null | awk 'NR==2{print $3" из "$2" (свободно "$4")"}')"
}

cmd_baked() {
    say "=== пакеты Debian 12 (Bookworm armhf), включённые при сборке образа ==="
    if [ -f "$BAKED" ]; then
        head -60 "$BAKED" | sed 's/^/  /'
        local total
        total=$(wc -l < "$BAKED")
        [ "$total" -gt 60 ] && say "  ... (всего $total пакетов в $BAKED)"
    else
        dpkg-query -W -f='  ${Package} ${Version}\n' 2>/dev/null | sort | head -60
    fi
}

cmd_local() {
    need_root
    local d="${1:-$DEBDIR}"
    [ -d "$d" ] || die "каталога $d нет (раздел BOOT примонтирован? mount | grep /boot)"
    shopt -s nullglob
    local files=("$d"/*.deb)
    shopt -u nullglob
    [ "${#files[@]}" -gt 0 ] || die "в $d нет файлов .deb"
    ok "устанавливаю локальные пакеты из $d:"
    for f in "${files[@]}"; do
        say "  $(basename "$f") ($(du -h "$f" | cut -f1))"
    done
    if dpkg -i "${files[@]}"; then
        ok "локальные пакеты установлены"
        return 0
    fi
    warn "dpkg сообщил о недостающих зависимостях - пробую apt-get install -f..."
    DEBIAN_FRONTEND=noninteractive apt-get install -f -y --no-install-recommends
}

cmd_net() {
    say "=== сеть для пакетного менеджера apt ==="
    say "  время: $(date -u '+%Y-%m-%d %H:%M:%S UTC')$(time_bad && echo '  <-- ТРЕБУЕТ СИНХРОНИЗАЦИИ (pkg time)')"
    say "  интерфейсы:"
    ip -o -4 addr show 2>/dev/null | awk '{printf "    %-8s %s (%s)\n", $2, $4, $NF}'
    say "  маршруты:"
    ip route 2>/dev/null | sed 's/^/    /'
    local gw
    gw=$(ip route 2>/dev/null | awk '/^default/{print $3; exit}')
    say "  DNS: $(awk '/^nameserver/{printf "%s ", $2}' /etc/resolv.conf 2>/dev/null)"
    say "  репозитории:"
    [ -f "$SOURCES" ] && sed 's/^/    /' "$SOURCES"
    say "  проверки:"
    if [ -n "$gw" ]; then
        ping -c1 -W3 "$gw" >/dev/null 2>&1 && say "    шлюз $gw: ОК" || say "    шлюз $gw: НЕ отвечает"
    else
        say "    шлюза нет (интернет не настроен)"
    fi
    ping -c1 -W3 1.1.1.1 >/dev/null 2>&1 && say "    1.1.1.1: ОК" || say "    1.1.1.1: нет ответа"
    ping -c1 -W3 deb.debian.org >/dev/null 2>&1 && say "    DNS + deb.debian.org: ОК" || say "    deb.debian.org: не резолвится/не отвечает"
}

cmd_fix() {
    need_root; have_apt
    ok "восстановление прерванных пакетов (dpkg --configure -a && apt-get install -f)..."
    dpkg --configure -a
    DEBIAN_FRONTEND=noninteractive apt-get install -f -y --no-install-recommends
}

cmd_cache() {
    need_root; have_apt
    case "${1:-clean}" in
        clean)
            apt-get clean
            rm -rf /var/cache/apt/archives/*.deb /var/lib/apt/lists/* 2>/dev/null || true
            ok "кэш apt и списки пакетов очищены"
            ;;
        *)
            say "кэш /var/cache/apt: $(du -sh /var/cache/apt 2>/dev/null | cut -f1)"
            say "списки /var/lib/apt/lists: $(du -sh /var/lib/apt/lists 2>/dev/null | cut -f1)"
            ;;
    esac
}

cmd_space() {
    say "=== дисковое пространство и память ==="
    df -h / /boot /tmp /var/tmp /var/log 2>/dev/null | sed 's/^/  /'
    say ""
    say "=== ОЗУ и сжатый swap (zram) ==="
    free -h 2>/dev/null | sed 's/^/  /'
    if command -v zramctl >/dev/null 2>&1; then
        zramctl 2>/dev/null | sed 's/^/  /'
    fi
}

usage() {
    cat <<EOF
pkg - управление пакетами Debian 12 Bookworm (armhf) на Informer 701

  pkg update                обновить индекс пакетов (apt-get update)
  pkg add <пакет> ...       установить пакет без лишних recommends
  pkg del <пакет> ...       удалить пакет
  pkg search <строка>       поиск пакета в репозитории (apt-cache search)
  pkg info <пакет>          описание и состояние пакета (dpkg / apt-cache)
  pkg deps <пакет>          симуляция установки и зависимостей
  pkg list                  список установленных пакетов (dpkg)
  pkg baked                 список пакетов, вшитых при сборке образа
  pkg local [каталог]       установить .deb без интернета (по умолчанию /boot/deb)
  pkg net                   диагностика сети, времени и доступности deb.debian.org
  pkg time                  синхронизировать системные часы (NTP / HTTP Date)
  pkg repo [show|http|https] просмотр или переключение протокола зеркала Debian
  pkg fix                   исправить прерванную установку (dpkg --configure -a)
  pkg cache clean           очистить кэш apt и списки пакетов
  pkg space                 свободное место на разделах, tmpfs и zram

Напрямую также доступны стандартные команды Debian: apt, apt-get, apt-cache, dpkg.
Офлайн-установка: скопируйте файлы *.deb для armhf в каталог deb раздела BOOT.
EOF
}

cmd="${1:-help}"
shift 2>/dev/null || true
case "$cmd" in
    update|up)      cmd_update ;;
    add|install|i)  cmd_add "$@" ;;
    del|remove|rm)  cmd_del "$@" ;;
    search|se|find) cmd_search "$@" ;;
    info|show)      cmd_info "$@" ;;
    deps|sim)       cmd_deps "$@" ;;
    list|ls|installed) cmd_list ;;
    baked)          cmd_baked ;;
    local)          cmd_local "$@" ;;
    net|diag)       cmd_net ;;
    time|clock)     cmd_time ;;
    repo|mirror)    cmd_repo "$@" ;;
    fix)            cmd_fix ;;
    cache)          cmd_cache "$@" ;;
    space|df|status|st) cmd_space ;;
    help|-h|--help|"") usage ;;
    *)              usage; exit 1 ;;
esac
