#!/bin/sh
# diag - полный снимок состояния платы Informer 701 (Allwinner A10 / N708H6)
# Вывод можно целиком отправить в лог UART: diag > /tmp/diag.txt

sep() { printf '\n===== %s =====\n' "$1"; }

sep "СИСТЕМА"
date
uname -a
echo "build:      $(cat /etc/build-id 2>/dev/null)"
echo "model:      $(cat /proc/device-tree/model 2>/dev/null | tr -d '\0')"
echo "compatible: $(cat /proc/device-tree/compatible 2>/dev/null | tr '\0' ' ')"
echo "cmdline:    $(cat /proc/cmdline)"
echo "DTB:        $(ls -l /proc/device-tree 2>/dev/null | head -1)"
head -12 /proc/cpuinfo
echo "--- память ---"
head -3 /proc/meminfo
echo "--- uptime/load ---"
cat /proc/uptime; cat /proc/loadavg

sep "ЧАСТОТЫ И НАПРЯЖЕНИЯ"
clk
echo "--- cpufreq (sysfs) ---"
CF=/sys/devices/system/cpu/cpu0/cpufreq
if [ -d "$CF" ]; then
    for f in scaling_driver scaling_governor scaling_cur_freq scaling_min_freq \
             scaling_max_freq cpuinfo_cur_freq cpuinfo_min_freq cpuinfo_max_freq \
             scaling_available_frequencies scaling_available_governors; do
        printf '%-34s %s\n' "$f" "$(cat $CF/$f 2>/dev/null)"
    done
else
    echo "нет - cpufreq-dt не зарегистрирован (нет OPP-таблицы, нет cpu-supply,"
    echo "      PMIC не прозондирован, или стоит initcall_blacklist=cpufreq_dt_platdev_init)"
fi
echo "--- regulators (sysfs) ---"
if ls /sys/class/regulator/ >/dev/null 2>&1 && [ -n "$(ls -A /sys/class/regulator 2>/dev/null)" ]; then
    for d in /sys/class/regulator/*; do
        printf '%-14s %-12s %10s uV  (%s)\n' "$(basename $d)" \
            "$(cat $d/name 2>/dev/null)" "$(cat $d/microvolts 2>/dev/null)" \
            "$(cat $d/state 2>/dev/null)"
    done
else
    echo "нет (PMIC отключён в DTB или не прозондирован)"
fi
if [ -r /sys/kernel/debug/regulator/regulator_summary ]; then
    echo "--- regulator_summary (debugfs) ---"
    cat /sys/kernel/debug/regulator/regulator_summary
fi
# clk_summary печатает вызванный выше clk - не дублируем, там фильтр
# подобран так, чтобы pll-core/cpu/axi/ahb/apb0 не вытесняли дети apb1-*
echo "--- thermal ---"
TZ=0
for z in /sys/class/thermal/thermal_zone*; do
    [ -e "$z" ] || continue
    TZ=$((TZ + 1))
    echo "$(basename $z): type=$(cat $z/type 2>/dev/null) temp=$(cat $z/temp 2>/dev/null)"
done
[ "$TZ" -eq 0 ] && echo "нет thermal-зон: у A10 в mainline нет температурного датчика - это штатно"

echo "--- срез частоты (sysfs и регистры CCU подряд) ---"
if [ -d "$CF" ]; then
    S1=$(cat $CF/scaling_cur_freq 2>/dev/null)
    HW=$(clk 2>/dev/null | sed -n 's/.*CPU = \([0-9]*\) MHz.*/\1/p' | head -1)
    S2=$(cat $CF/scaling_cur_freq 2>/dev/null)
    echo "  sysfs scaling_cur_freq: ${S1:-?} kHz (до) / ${S2:-?} kHz (после)"
    echo "  PLL1 по регистрам CCU между ними: ${HW:-?} МГц"
    echo "  (governor schedutil меняет частоту на ходу, поэтому показания в разных"
    echo "   разделах diag могут различаться - это работа DVFS, а не ошибка)"
fi

sep "AXP209 (PMIC) НА I2C0"
pmic 30
pmic-regs

sep "ПРЕРЫВАНИЯ"
cat /proc/interrupts

sep "DMESG: PMIC / REGULATOR"
dmesg | grep -iE 'axp|pmic|regulator|i2c|twi' | tail -40

sep "DMESG: CLOCK / CPUFREQ / OPP"
dmesg | grep -iE 'cpufreq|opp|clk|pll|clock' | tail -40

sep "DMESG: MMC / SD"
dmesg | grep -iE 'mmc|sdio|sunxi-mmc' | tail -25

sep "DMESG: ОШИБКИ И ПРЕДУПРЕЖДЕНИЯ"
dmesg | grep -iE 'error|fail|bad |panic|oops|stall|warn|unable|timeout' | tail -40

sep "DMESG: ПОСЛЕДНИЕ 30 СТРОК"
dmesg | tail -30

sep "РЕГИСТРЫ CCU / UART0 / MMC0"
regs

sep "БЛОЧНЫЕ УСТРОЙСТВА И РАЗДЕЛЫ"
cat /proc/partitions
mount | head -20
df -h 2>/dev/null | head -10

sep "КОНЕЦ"
echo "Сохранить в файл:  diag > /tmp/diag.txt"
echo "Скопировать на boot-раздел (vfat, видно с ПК):  diag > /boot/diag.txt && sync"
