#!/bin/bash
# whichboot - какой именно пункт меню U-Boot (/boot/extlinux/extlinux.conf) загрузился
#
#   whichboot        - человекочитаемый отчёт
#   whichboot -l     - только label (для скриптов)
#   whichboot -n     - только номер пункта

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH LC_ALL=C

OPT="${1:-}"
CONF=/boot/extlinux/extlinux.conf
CMD=$(cat /proc/cmdline 2>/dev/null || true)
BUILD=$(cat /etc/build-id 2>/dev/null || echo debian12)
MODEL=$(tr -d '\0' < /proc/device-tree/model 2>/dev/null || true)

norm() { printf '%s' "$1" | tr -s ' \t' ' ' | sed -e 's/^ //' -e 's/ $//'; }
CMD_N=$(norm "$CMD")

dtbmodel() {
    local _m
    _m=$(grep -a -o 'Informer 701[ -~]*' "$1" 2>/dev/null | head -n1 || true)
    [ -n "$_m" ] && { printf '%s' "$_m"; return 0; }
    tr -c ' -~' '\n' < "$1" 2>/dev/null | grep -m1 'Informer 701' | sed 's/^[^A-Za-z]*//' || true
}

entries() {
    awk '
        function flush() { if (lbl != "") printf "%d|%s|%s|%s\n", n, lbl, dtb, ap }
        /^[ \t]*label[ \t]/      { flush(); n++; lbl=$2; dtb=""; ap=""; next }
        /^[ \t]*devicetree[ \t]/ { dtb=$2; next }
        /^[ \t]*append[ \t]/     { sub(/^[ \t]*append[ \t]+/, "");
                                   gsub(/[ \t]+/, " "); sub(/^ /, ""); sub(/ $/, "");
                                   ap=$0; next }
        END { flush() }
    ' "$CONF" 2>/dev/null
}

LBL=""; NUM=""; DTB=""; AMBIG=""; RESOLVED=""
if [ -r "$CONF" ]; then
    CAND=""
    while IFS='|' read -r n l d a; do
        [ -n "$l" ] || continue
        [ "$a" = "$CMD_N" ] || continue
        CAND="$CAND $n:$l:$d"
    done < <(entries)

    if [ -n "$MODEL" ]; then
        for c in $CAND; do
            n=${c%%:*}; rest=${c#*:}; l=${rest%%:*}; d=${rest#*:}
            [ -n "$d" ] && [ -r "/boot$d" ] || continue
            [ "$(dtbmodel "/boot$d")" = "$MODEL" ] || continue
            NUM=$n; LBL=$l; DTB=$d; RESOLVED=by-dtb
            break
        done
    fi
    if [ -z "$LBL" ] && [ -n "$CAND" ]; then
        for c in $CAND; do
            n=${c%%:*}; rest=${c#*:}; l=${rest%%:*}; d=${rest#*:}
            NUM=$n; LBL=$l; DTB=$d; RESOLVED=by-cmdline
            break
        done
        # shellcheck disable=SC2086
        NC=$(printf '%s\n' $CAND | grep -c . || true)
        [ "${NC:-0}" -gt 1 ] && AMBIG="$CAND"
    fi
fi

[ -z "$LBL" ] && LBL=unknown
SAFE=$(printf '%s' "$LBL" | tr -cd 'A-Za-z0-9_-')
[ -z "$SAFE" ] && SAFE=unknown

case "$OPT" in
    -l) echo "$SAFE"; exit 0 ;;
    -n) echo "${NUM:-0}"; exit 0 ;;
esac

echo "=== что загрузилось ==="
printf '  build      : %s\n' "$BUILD"
if [ -n "$NUM" ]; then
    printf '  пункт меню : %s  (label "%s")\n' "$NUM" "$LBL"
    printf '  devicetree : %s\n' "${DTB:-?}"
else
    echo   '  пункт меню : не определён (загрузка вне меню extlinux или QEMU)'
fi
if [ -n "$AMBIG" ]; then
    echo "  (cmdline одинаков у нескольких пунктов:$AMBIG)"
elif [ "$RESOLVED" = by-dtb ]; then
    echo "  (определено по cmdline и модели DTB - точно)"
elif [ "$RESOLVED" = by-cmdline ]; then
    echo "  (определено по cmdline)"
fi
printf '  DTB model  : %s\n' "${MODEL:-?}"
printf '  cmdline    : %s\n' "$CMD"

CF=/sys/devices/system/cpu/cpu0/cpufreq
if [ -d "$CF" ]; then
    printf '  cpufreq    : зарегистрирован, governor=%s, cur=%s kHz\n' \
        "$(cat "$CF/scaling_governor" 2>/dev/null)" "$(cat "$CF/scaling_cur_freq" 2>/dev/null)"
    printf '  OPP        : %s kHz\n' "$(cat "$CF/scaling_available_frequencies" 2>/dev/null)"
else
    echo  '  cpufreq    : НЕ зарегистрирован (ядро частотой не управляет)'
fi

PM=no
for d in /sys/class/regulator/*; do
    [ -e "$d" ] || continue
    case "$(cat "$d/name" 2>/dev/null)" in *dcdc2*|*vdd-cpu*) PM=yes ;; esac
done
echo "  PMIC в ядре : $([ "$PM" = yes ] && echo 'виден (regulators AXP209 зарегистрированы)' || echo 'не виден (regulators AXP209 нет)')"
echo
echo "  сохранить полный лог на FAT-раздел: savelog"
