#!/bin/sh
# whichboot - какой именно пункт меню U-Boot загрузился.
#
# Зачем: имена файлов с логами легко перепутать (был случай, когда лог от
# пункта safe ушёл как "pinned"). Распознавание точное и двойное:
#   1) строка append из /boot/extlinux/extlinux.conf дословно становится
#      /proc/cmdline;
#   2) но у трёх пар пунктов append одинаковый (pinned/nofreq/wdt и
#      base-perf/flatvolt) - они различаются только DTB, поэтому сверяем ещё и
#      /proc/device-tree/model со строкой model внутри файла /boot/<dtb>.
#
#   whichboot        - человекочитаемый отчёт
#   whichboot -l     - только label (для скриптов)
#   whichboot -n     - только номер пункта

OPT="$1"     # запоминаем сразу: дальше по коду меняются переменные, а не $1

CONF=/boot/extlinux/extlinux.conf
CMD=$(cat /proc/cmdline 2>/dev/null)
BUILD=$(cat /etc/build-id 2>/dev/null || echo dev)
MODEL=$(tr -d '\0' < /proc/device-tree/model 2>/dev/null)

norm() { echo "$1" | tr -s ' \t' ' ' | sed -e 's/^ //' -e 's/ $//'; }
CMD_N=$(norm "$CMD")

# Строка model из бинарного DTB. ВАЖНО: busybox tr НЕ поддерживает класс
# [:print:] (на целевом busybox 1.36.1 "tr -c '[:print:]'" даёт 0 совпадений,
# на GNU tr работает - поэтому стенд на хосте баг не ловил). Используем grep -a -o
# с явным диапазоном печатных символов 0x20-0x7e; запасной вариант - tr с тем же
# диапазоном (в tr диапазон задаётся как ' -~', а не '[:print:]').
dtbmodel() {
    _m=$(grep -a -o 'Informer 701[ -~]*' "$1" 2>/dev/null | head -n1)
    [ -n "$_m" ] && { printf '%s' "$_m"; return 0; }
    tr -c ' -~' '\n' < "$1" 2>/dev/null | grep -m1 'Informer 701' | sed 's/^[^A-Za-z]*//'
}

# --- разбор extlinux.conf ---------------------------------------------------
# на выходе строки: "<номер>|<label>|<devicetree>|<append>"
entries() {
    awk '
        function flush() { if (lbl != "") printf "%d|%s|%s|%s\n", n, lbl, dtb, ap }
        /^[ \t]*label[ \t]/      { flush(); n++; lbl=$2; dtb=""; ap="" ; next }
        /^[ \t]*devicetree[ \t]/ { dtb=$2; next }
        /^[ \t]*append[ \t]/     { sub(/^[ \t]*append[ \t]+/, "");
                                   gsub(/[ \t]+/, " "); sub(/^ /, ""); sub(/ $/, "");
                                   ap=$0; next }
        END { flush() }
    ' "$CONF" 2>/dev/null
}

LBL=""; NUM=""; DTB=""; AMBIG=""
if [ -r "$CONF" ]; then
    # все пункты, у которых append совпал с /proc/cmdline: "номер:label:dtb ..."
    CAND=""
    while IFS='|' read -r n l d a; do
        [ -n "$l" ] || continue
        [ "$a" = "$CMD_N" ] || continue
        CAND="$CAND $n:$l:$d"
    done <<EOF
$(entries)
EOF
    # 1) среди кандидатов ищем того, у кого model внутри DTB совпал с живой
    if [ -n "$MODEL" ]; then
        for c in $CAND; do
            n=${c%%:*}; rest=${c#*:}; l=${rest%%:*}; d=${rest#*:}
            [ -n "$d" ] && [ -r "/boot$d" ] || continue
            [ "$(dtbmodel "/boot$d")" = "$MODEL" ] || continue
            NUM=$n; LBL=$l; DTB=$d; RESOLVED=by-dtb
            break
        done
    fi
    # 2) не вышло (DTB не читается / model не совпала) - берём первого кандидата
    if [ -z "$LBL" ] && [ -n "$CAND" ]; then
        for c in $CAND; do
            n=${c%%:*}; rest=${c#*:}; l=${rest%%:*}; d=${rest#*:}
            NUM=$n; LBL=$l; DTB=$d; RESOLVED=by-cmdline
            break
        done
        NC=$(printf '%s\n' $CAND | grep -c .)
        [ "$NC" -gt 1 ] && AMBIG="$CAND"
    fi
fi

[ -z "$LBL" ] && LBL=unknown
# имя, пригодное для файла
SAFE=$(echo "$LBL" | tr -cd 'A-Za-z0-9_-')
[ -z "$SAFE" ] && SAFE=unknown

case "$OPT" in
    -l) echo "$SAFE"; exit 0 ;;
    -n) echo "${NUM:-0}"; exit 0 ;;
esac

echo "=== что загрузилось ==="
printf '  build      : %s\n' "$BUILD"
if [ -n "$NUM" ]; then
    printf '  пункт меню : %s  (label "%s")\n' "$NUM" "$LBL"
    printf '  devicetree : %s\n' "${DTB:-?}"
else
    echo   '  пункт меню : не определён'
    echo   "  (нет $CONF или /boot не примонтирован - например, initramfs)"
fi
if [ -n "$AMBIG" ]; then
    echo "  (cmdline одинаков у нескольких пунктов:$AMBIG;"
    echo "   модель DTB не совпала ни с одной - взят первый, проверьте /boot)"
elif [ "$RESOLVED" = by-dtb ]; then
    echo "  (определено по cmdline и модели DTB - точно)"
else
    echo "  (определено по cmdline; DTB-модель не сверялась)"
fi
printf '  DTB model  : %s\n' "${MODEL:-?}"
printf '  cmdline    : %s\n' "$CMD"

CF=/sys/devices/system/cpu/cpu0/cpufreq
if [ -d "$CF" ]; then
    printf '  cpufreq    : зарегистрирован, governor=%s, cur=%s kHz\n' \
        "$(cat $CF/scaling_governor 2>/dev/null)" "$(cat $CF/scaling_cur_freq 2>/dev/null)"
    printf '  OPP        : %s kHz\n' "$(cat $CF/scaling_available_frequencies 2>/dev/null)"
else
    echo  '  cpufreq    : НЕ зарегистрирован (ядро частотой не управляет)'
fi

PM=no
for d in /sys/class/regulator/*; do
    [ -e "$d" ] || continue
    case "$(cat $d/name 2>/dev/null)" in *dcdc2*|*vdd-cpu*) PM=yes;; esac
done
echo "  PMIC в ядре : $([ "$PM" = yes ] && echo 'виден (regulators AXP209 зарегистрированы)' || echo 'не виден (regulators AXP209 нет)')"
echo
echo "  имя для лога: /boot/diag-$BUILD-$SAFE.txt   (или просто команда: savelog)"
