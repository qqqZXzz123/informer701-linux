#!/bin/bash
# i2cbus - вывести номер шины I2C, на которой сидит AXP209 (TWI0 @ 0x01c2ac00)
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

for d in /sys/bus/i2c/devices/i2c-*; do
    [ -e "$d" ] || continue
    p=$(readlink -f "$d" 2>/dev/null)
    case "$p" in
        *1c2ac00.i2c*)
            b="${d##*i2c-}"
            echo "${b%%/*}"
            exit 0 ;;
    esac
done
echo 0
