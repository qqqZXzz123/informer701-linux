#!/bin/sh
# i2cbus - найти номер шины, на которой отвечает AXP209 (адрес 0x34).
# В DTB теперь есть алиас i2c0 = /soc/i2c@1c2ac00, так что обычно это 0,
# но определяем реально, чтобы не зависеть от порядка пробинга драйверов.
# Переопределение: I2CBUS=1 diag
if [ -n "$I2CBUS" ]; then echo "$I2CBUS"; exit 0; fi
for d in /dev/i2c-*; do
    [ -e "$d" ] || continue
    n=${d#/dev/i2c-}
    if i2cget -f -y "$n" 0x34 0x03 >/dev/null 2>&1; then
        echo "$n"; exit 0
    fi
done
# AXP209 не ответил ни на одной шине - возвращаем 0, диагностика это покажет
echo 0
