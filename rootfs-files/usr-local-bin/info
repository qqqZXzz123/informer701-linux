#!/bin/bash
# info - короткая сводка по плате Informer 701 (Debian 12 Bookworm armhf)
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH LC_NUMERIC=C

echo "Informer 701 (N708H6, Allwinner A10)   build $(cat /etc/build-id 2>/dev/null)"
echo "---------------------------------------------------------------------"
printf '%-14s %s\n' "система:"   "$(. /etc/os-release 2>/dev/null && echo "${PRETTY_NAME:-Debian}" || echo Debian)"
printf '%-14s %s\n' "ядро:"      "$(uname -r)  $(uname -v | cut -c1-40)"
printf '%-14s %s\n' "модель DT:" "$(tr -d '\0' < /proc/device-tree/model 2>/dev/null)"
printf '%-14s %s\n' "cmdline:"   "$(cat /proc/cmdline)"
printf '%-14s %s\n' "uptime:"    "$(cut -d' ' -f1 /proc/uptime) c"
printf '%-14s %s\n' "память:"    "$(awk '/MemTotal/{printf "%d МиБ", $2/1024}' /proc/meminfo) (zram: $(awk 'NR>1{printf "%d МиБ", $3/1024; exit}' /proc/swaps 2>/dev/null || echo 'нет'))"
printf '%-14s %s\n' "корень:"    "$(awk '$2=="/"{print $1" ("$3")"}' /proc/mounts) ($(df -h / 2>/dev/null | awk 'NR==2{print $3" занято / "$4" свободно"}'))"
if mountpoint -q /mnt/share 2>/dev/null; then
    printf '%-14s %s\n' "обмен с ПК:" "/mnt/share ($(awk '$2=="/mnt/share"{print $3}' /proc/mounts), свободно $(df -h /mnt/share 2>/dev/null | awk 'NR==2{print $4}'))"
else
    printf '%-14s %s\n' "обмен с ПК:" "не создан (запустите rootfs-expand)"
fi
CF=/sys/devices/system/cpu/cpu0/cpufreq
if [ -d "$CF" ]; then
    printf '%-14s %s\n' "CPU частота:" "$(cat "$CF/scaling_cur_freq") kHz ($(cat "$CF/scaling_governor"))"
else
    printf '%-14s %s\n' "CPU частота:" "не управляется ядром (фиксирована SPL)"
fi
WDT_OPEN="выкл"
readlink /proc/1/fd/* 2>/dev/null | grep -q '^/dev/watchdog' && WDT_OPEN="активен (PID 1 systemd)"
WDT_REG=$(devmem2 0x01c20c94 w 2>/dev/null | awk '/Read at address/{print $NF}')
printf '%-14s %s\n' "watchdog:"  "$WDT_OPEN (WDOG_MODE=${WDT_REG:-?})"
printf '%-14s %s\n' "AXP209:"    "$(i2cget -f -y 0 0x34 0x03 2>/dev/null || echo 'не отвечает')"
echo
echo "Команды: rootfs-expand  wifi-config  wifi  usbnet  pkg  diag  savelog  accel  pmic  pmic-vbus  wdt  bootnext  info"
