#!/bin/bash
# pmic-vbus - напряжение питания платы по АЦП AXP209 (шина I2C0, адрес 0x34)
#
#   pmic-vbus                  одно измерение
#   pmic-vbus watch [N]        N измерений с интервалом 1 с (по умолчанию 30)
#   pmic-vbus log [файл] [N]   писать в файл (по умолчанию /boot/vbus.log) с sync
#   pmic-vbus reg              сырые регистры АЦП и что включено
#
# Пороги: >= 4.70 В норма, 4.40..4.70 В просадка, < 4.40 В критично.
# Регистры AXP209 (12 бит): 0x5A/0x5B VBUS U (1.7 мВ), 0x5C/0x5D VBUS I (1.4 мА),
# 0x56/0x57 ACIN U (1.7 мВ), 0x78/0x79 батарея U (1.1 мВ), 0x82 ADC enable.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH LC_NUMERIC=C

BUS=$(i2cbus)
ADDR=0x34
DEF_LOG=/boot/vbus.log

rd() { i2cget -f -y "$BUS" "$ADDR" "$1" 2>/dev/null; }

adc_enable() {
    local ae
    ae=$(rd 0x82) || return 1
    [ -n "$ae" ] || return 1
    if [ $(( ae & 0x3f )) -ne 63 ]; then
        i2cset -f -y "$BUS" "$ADDR" 0x82 $(( ae | 0x3f )) >/dev/null 2>&1
        sleep 1
    fi
    return 0
}

adc12() {
    local hi lo
    hi=$(rd "$1") || return 1
    lo=$(rd "$2") || return 1
    [ -n "$hi" ] && [ -n "$lo" ] || return 1
    echo $(( ((hi << 4) | ((lo >> 4) & 0x0f)) ))
}

to_mv() {
    [ -n "${1:-}" ] || { echo 0; return; }
    echo $(( $1 * $2 / 10 ))
}

read_all() {
    VRAW=$(adc12 0x5a 0x5b || true); IRAW=$(adc12 0x5c 0x5d || true)
    ARAW=$(adc12 0x56 0x57 || true); BRAW=$(adc12 0x78 0x79 || true)
    VBUS_MV=$(to_mv "$VRAW" 17); IBUS_MA=$(to_mv "$IRAW" 14)
    ACIN_MV=$(to_mv "$ARAW" 17); BAT_MV=$(to_mv "$BRAW" 11)
    ST=$(rd 0x00 || true)
}

verdict() {
    local v="$1"
    [ "$v" -le 0 ] && { echo "НЕТ ПИТАНИЯ"; return; }
    [ "$v" -ge 4700 ] && { echo "норма"; return; }
    [ "$v" -ge 4400 ] && { echo "ПРОСАДКА"; return; }
    echo "КРИТИЧНО"
}

fmt() {
    printf '%s  VBUS %5d мВ  ток %5d мА  ACIN %5d мВ  бат %5d мВ  [%s] vbus=%s acin=%s' \
        "$(date '+%H:%M:%S')" "$VBUS_MV" "$IBUS_MA" "$ACIN_MV" "$BAT_MV" \
        "$(verdict "$VBUS_MV")" \
        "$([ -n "$ST" ] && [ $(( (ST >> 6) & 1 )) -eq 1 ] && echo есть || echo нет)" \
        "$([ -n "$ST" ] && [ $(( (ST >> 7) & 1 )) -eq 1 ] && echo есть || echo нет)"
}

one() {
    adc_enable || { echo "AXP209 не отвечает по I2C (шина $BUS) - проверьте pmic-regs"; return 1; }
    read_all
    if [ -z "$VRAW" ]; then
        echo "АЦП VBUS не читается (регистр 0x82 = $(rd 0x82))"
        return 1
    fi
    fmt; echo
    local v
    v=$(verdict "$VBUS_MV")
    case "$v" in
        "НЕТ ПИТАНИЯ") echo "  VBUS = 0: питание от USB не приходит вовсе" ;;
        "норма")       echo "  питание в норме (нужно >= 4.70 В)" ;;
        *)             echo "  ВНИМАНИЕ: $v (< 4.4 В - плата может сбрасываться молча)."
                       echo "  Рекомендации: БП 5 В >= 2 А, короткий толстый кабель, wifi tx 5." ;;
    esac
}

series() {
    local f="$1" n="${2:-30}"
    adc_enable || { echo "AXP209 не отвечает по I2C (шина $BUS)"; return 1; }
    local min=999999 max=0 i=0 bad=0 line
    if [ "$f" != "-" ]; then
        : > "$f" 2>/dev/null || { echo "не пишу в $f"; return 1; }
        echo "# pmic-vbus: шина $BUS, отсчётов $n, интервал 1 с" >> "$f"
    else
        echo "отсчётов: $n (1 в секунду); минимум за прогон будет в конце"
    fi
    while [ "$i" -lt "$n" ]; do
        i=$((i+1))
        read_all
        if [ -z "$VRAW" ]; then
            line="$(date '+%H:%M:%S')  АЦП не читается"
        else
            line=$(fmt)
            [ "$VBUS_MV" -lt "$min" ] && min=$VBUS_MV
            [ "$VBUS_MV" -gt "$max" ] && max=$VBUS_MV
            [ "$VBUS_MV" -lt 4700 ] && bad=$((bad+1))
        fi
        if [ "$f" = "-" ]; then
            echo "$line"
        else
            echo "$line" >> "$f"
            [ $(( i % 5 )) -eq 0 ] && sync
        fi
        sleep 1
    done
    [ "$f" != "-" ] && sync
    if [ "$max" -gt 0 ]; then
        local s="итог за ${i} с: MIN ${min} мВ, MAX ${max} мВ, отсчётов ниже 4.70 В: ${bad}"
        [ "$f" = "-" ] && echo "$s" || echo "$s" >> "$f"
        if [ "$bad" -gt 0 ]; then
            [ "$f" = "-" ] && echo "  -> есть просадки: нужен источник 5 В мощнее и/или wifi tx 5"
            [ "$f" != "-" ] && echo "просадка" >> "$f"
        fi
    fi
}

cmd_reg() {
    adc_enable || true
    echo "=== AXP209 АЦП (шина /dev/i2c-$BUS, адрес $ADDR) ==="
    for r in 0x82 0x56 0x57 0x58 0x59 0x5a 0x5b 0x5c 0x5d 0x78 0x79 0x00 0x01; do
        printf '  %s = %s\n' "$r" "$(rd "$r" || true)"
    done
    echo "  0x82 биты: 0=батарея U 1=батарея I 2=ACIN U 3=ACIN I 4=VBUS U 5=VBUS I"
    echo "  0x00 биты: 7=ACIN есть 6=VBUS есть 4..3=состояние батареи"
}

usage() {
    sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-one}" in
    one|"")  one ;;
    watch|w) series - "${2:-30}" ;;
    log|l)
        f="${2:-}"; n="${3:-}"
        case "$f" in ""|-*) n="${2:-180}"; f="$DEF_LOG" ;; esac
        series "$f" "${n:-180}"
        echo "записано: $f (FAT-раздел виден с ПК)" ;;
    reg|r)   cmd_reg ;;
    help|-h|--help) usage ;;
    *)       usage; exit 1 ;;
esac
