#!/bin/sh
# pmic-vbus - напряжение питания платы по АЦП AXP209 (шина I2C0, адрес 0x34)
#
#   pmic-vbus                  одно измерение
#   pmic-vbus watch [N]        N измерений с интервалом 1 с (по умолчанию 30)
#   pmic-vbus log [файл] [N]   то же, но писать в файл (по умолчанию
#                              /boot/vbus.log) и сбрасывать на карту - последние
#                              строки уцелеют, даже если плата зависнет
#   pmic-vbus reg              сырые регистры АЦП и что включено
#
# ЗАЧЕМ ЭТО НУЖНО. Плата питается от USB компьютера (обычно не больше 0.9 А).
# Передатчик RTL8188FU в момент ассоциации и передачи даёт импульсы в сотни мА,
# SD-карта при чтении тоже ест ток. Если источник слабый, напряжение 5 В
# проседает - и плата зависает или молча перезагружается, НЕ напечатав в UART
# ни строчки (ни паники, ни oops). Это выглядит как "образ нестабильный", хотя
# образ ни при чём. AXP209 измеряет VBUS сам, поэтому просадку видно численно.
#
# КАК ПРОВЕРИТЬ WiFi (главный опыт):
#   pmic-vbus log /boot/vbus.log 180 &      # писать 3 минуты
#   wifi connect 'MyHome' '<пароль>'  # и сразу подключаемся
#   wait
# Файл /boot/vbus.log лежит на FAT-разделе, его видно с ПК даже после
# перезагрузки платы. Смотрите столбец MIN - это минимум за всё время.
#
# ПОРОГИ.  >= 4.70 В - нормально.  4.40...4.70 В - просадка, уже рискованно.
# < 4.40 В - критично: DC-DC AXP209 на таком входе не держит 1.2 В ядра,
# плата сбрасывается. 0 В - питания от USB нет (проверьте кабель/разъём).
#
# ЧТО ДЕЛАТЬ ПРИ ПРОСАДКЕ. 1) источник 5 В >= 2 А (зарядник или
# USB-хаб с питанием) вместо порта ПК; 2) короче и толще кабель;
# 3) ограничить мощность передатчика: wifi tx 5   (5 дБм);
# 4) конденсатор 470...1000 мкФ x 6.3 В низкоимпедансный параллельно входу 5 В
# рядом с разъёмом (плюс к 5 В, минус к земле).
#
# Регистры AXP209 (12 бит: старший регистр = биты 11..4, младший = 3..0):
#   0x56/0x57 ACIN напряжение, 1.7 мВ/отсчёт    0x58/0x59 ACIN ток, 1.4 мА
#   0x5A/0x5B VBUS напряжение, 1.7 мВ/отсчёт    0x5C/0x5D VBUS ток,   1.4 мА
#   0x78/0x79 батарея напряжение, 1.1 мВ/отсчёт 0x82 = ADC enable
# Формат отсчёта проверен на плате в pmic-regs (батарея: raw*11/10 мВ).

BUS=$(i2cbus)
ADDR=0x34
DEF_LOG=/boot/vbus.log

rd() { i2cget -f -y "$BUS" "$ADDR" "$1" 2>/dev/null; }

adc_enable() {
    ae=$(rd 0x82)
    [ -n "$ae" ] || return 1
    # нужны биты 0..5 (батарея U/I, ACIN U/I, VBUS U/I); TS (бит 7) не трогаем
    if [ $(( ae & 0x3f )) -ne 63 ]; then
        i2cset -f -y "$BUS" "$ADDR" 0x82 $(( ae | 0x3f )) >/dev/null 2>&1
        sleep 1
    fi
    return 0
}

adc12() {   # $1 = старший регистр, $2 = младший; печатает raw
    hi=$(rd "$1"); lo=$(rd "$2")
    [ -n "$hi" ] && [ -n "$lo" ] || return 1
    echo $(( ((hi << 4) | ((lo >> 4) & 0x0f)) ))
}

to_mv() {  # $1 = raw, $2 = десятых мВ на отсчёт -> милливольты
    [ -n "$1" ] || { echo 0; return; }
    echo $(( $1 * $2 / 10 ))
}

read_all() {
    VRAW=$(adc12 0x5a 0x5b); IRAW=$(adc12 0x5c 0x5d)
    ARAW=$(adc12 0x56 0x57); BRAW=$(adc12 0x78 0x79)
    VBUS_MV=$(to_mv "$VRAW" 17); IBUS_MA=$(to_mv "$IRAW" 14)
    ACIN_MV=$(to_mv "$ARAW" 17); BAT_MV=$(to_mv "$BRAW" 11)
    ST=$(rd 0x00)
}

verdict() {
    v=$1
    [ "$v" -le 0 ] && { echo "НЕТ ПИТАНИЯ"; return; }
    [ "$v" -ge 4700 ] && { echo "норма"; return; }
    [ "$v" -ge 4400 ] && { echo "ПРОСАДКА"; return; }
    echo "КРИТИЧНО"
}

fmt() {   # строка отсчёта
    printf '%s  VBUS %5d мВ  ток %5d мА  ACIN %5d мВ  бат %5d мВ  [%s] vbus=%s acin=%s' \
        "$(date '+%H:%M:%S')" "$VBUS_MV" "$IBUS_MA" "$ACIN_MV" "$BAT_MV" \
        "$(verdict "$VBUS_MV")" \
        "$([ -n "$ST" ] && [ $(( (ST >> 6) & 1 )) -eq 1 ] && echo есть || echo нет)" \
        "$([ -n "$ST" ] && [ $(( (ST >> 7) & 1 )) -eq 1 ] && echo есть || echo нет)"
}

one() {
    adc_enable || { echo "AXP209 не отвечает по I2C (шина $BUS) - проверьте pmic-regs"; return 1; }
    read_all
    if [ -z "$VRAW" ]; then
        echo "АЦП VBUS не читается (регистр 0x82 = $(rd 0x82))"
        return 1
    fi
    fmt; echo
    v=$(verdict "$VBUS_MV")
    case "$v" in
        "НЕТ ПИТАНИЯ") echo "  VBUS = 0: питание от USB не приходит вовсе" ;;
        "норма")       echo "  питание в норме (нужно >= 4.70 В)" ;;
        *)             echo "  ВНИМАНИЕ: $v. Меньше 4.4 В - плата может сбрасываться молча."
                       echo "  Источник 5 В >= 2 А, короткий толстый кабель, wifi tx 5, конденсатор"
                       echo "  470...1000 мкФ по входу 5 В. Полный разбор: docs/wifi-pakety-akselerometr.md" ;;
    esac
}

series() {   # $1 = файл ('-' = на экран), $2 = число отсчётов
    f=$1; n=${2:-30}
    adc_enable || { echo "AXP209 не отвечает по I2C (шина $BUS)"; return 1; }
    min=999999; max=0; i=0; bad=0
    [ "$f" != "-" ] && { : > "$f" 2>/dev/null || { echo "не пишу в $f"; return 1; }
        echo "# pmic-vbus: шина $BUS, отсчётов $n, интервал 1 с" >> "$f"; }
    [ "$f" = "-" ] && echo "отсчётов: $n (1 в секунду); минимум за прогон будет в конце"
    while [ "$i" -lt "$n" ]; do
        i=$((i+1))
        read_all
        if [ -z "$VRAW" ]; then
            line="$(date '+%H:%M:%S')  АЦП не читается"
        else
            line=$(fmt)
            [ "$VBUS_MV" -lt "$min" ] && min=$VBUS_MV
            [ "$VBUS_MV" -gt "$max" ] && max=$VBUS_MV
            [ "$VBUS_MV" -lt 4700 ] && bad=$((bad+1))
        fi
        if [ "$f" = "-" ]; then
            echo "$line"
        else
            echo "$line" >> "$f"
            [ $(( i % 5 )) -eq 0 ] && sync
        fi
        sleep 1
    done
    [ "$f" != "-" ] && sync
    if [ "$max" -gt 0 ]; then
        s="итог за ${i} с: MIN ${min} мВ, MAX ${max} мВ, отсчётов ниже 4.70 В: ${bad}"
        [ "$f" = "-" ] && echo "$s" || echo "$s" >> "$f"
        [ "$bad" -gt 0 ] && {
            [ "$f" = "-" ] && echo "  -> есть просадки: нужен источник 5 В мощнее и/или wifi tx 5"
            echo "просадка" >> "$f"
        }
    fi
}

cmd_reg() {
    adc_enable
    echo "=== AXP209 АЦП (шина /dev/i2c-$BUS, адрес $ADDR) ==="
    for r in 0x82 0x56 0x57 0x58 0x59 0x5a 0x5b 0x5c 0x5d 0x78 0x79 0x00 0x01; do
        printf '  %s = %s\n' "$r" "$(rd $r)"
    done
    echo "  0x82 биты: 0=батарея U 1=батарея I 2=ACIN U 3=ACIN I 4=VBUS U 5=VBUS I"
    echo "  0x00 биты: 7=ACIN есть 6=VBUS есть 4..3=состояние батареи"
}

usage() {
    sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-one}" in
    one|"")      one ;;
    watch|w)     series - "${2:-30}" ;;
    log|l)
        f=$2; n=$3
        case "$f" in ""|-*) n=${2:-180}; f=$DEF_LOG ;; esac
        series "$f" "$n"
        echo "записано: $f (FAT-раздел виден с ПК)" ;;
    reg|r)       cmd_reg ;;
    help|-h|--help) usage ;;
    *)           usage; exit 1 ;;
esac
