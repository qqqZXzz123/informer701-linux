#!/bin/bash
# memtest [размер_МиБ] [проходов] - стресс-тест DDR3 через memtester
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

MB="${1:-64}"
LOOPS="${2:-1}"
echo "Запускаю memtester ${MB}M x ${LOOPS} (Ctrl+C чтобы прервать)..."
echo "Перед стартом:"
clk | grep -E 'PLL1_CFG|CPU  =|PLL5_CFG'
exec memtester "${MB}M" "$LOOPS"
