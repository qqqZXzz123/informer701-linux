#!/bin/bash
# wifi - управление USB-WiFi адаптером на Informer 701 (Debian 12 Bookworm armhf)
#
# Разъём на месте бывшего WiFi-модуля = хост-порт USB2 (DP2/DM2), VBUS = PH3.
# Стек Debian: wpasupplicant (wpa_supplicant + wpa_cli + wpa_passphrase), iw,
# isc-dhcp-client (dhclient), hostapd, dnsmasq-base, iptables (legacy), kmod.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH LC_NUMERIC=C

CONF_DIR=/etc/wpa_supplicant
CONF=$CONF_DIR/wpa_supplicant.conf
HOSTAPD_CONF=/etc/hostapd/informer-ap.conf
REG_FILE=/etc/wifi-reg
AUTO_FLAG=/etc/wifi-enabled
LOG=/var/log/wifi.log
RUN=/run/wifi
CTRL_DIR=/var/run/wpa_supplicant
STATIC_FILE=/etc/wifi-static
TX_FILE=/etc/wifi-txpower
AP_NET=192.168.71
AP_IP=$AP_NET.1

say()  { printf '%s\n' "$*"; }
ok()   { printf '[wifi] %s\n' "$*"; }
warn() { printf '[wifi] ВНИМАНИЕ: %s\n' "$*" >&2; }
die()  { printf '[wifi] ОШИБКА: %s\n' "$*" >&2; exit 1; }
need_root() { [ "$(id -u)" -eq 0 ] || die "нужны права root"; }
has_systemd() { [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; }

# ---------------------------------------------------------------- базовое
load_stack() {
    modprobe -q cfg80211 2>/dev/null || true
    modprobe -q mac80211 2>/dev/null || true
    modprobe -q rfkill   2>/dev/null || true
    [ -f /lib/firmware/regulatory.db ] || warn "нет /lib/firmware/regulatory.db - iw reg set не сработает"
}

wl_list() {
    for i in /sys/class/net/*; do
        [ -e "$i" ] || continue
        local n
        n=$(basename "$i")
        case "$n" in p2p*) continue ;; esac
        if [ -d "$i/wireless" ] || [ -e "$i/phy80211" ]; then say "$n"; fi
    done
}

wl_count() { wl_list | wc -l | tr -d ' '; }

wl_pick() {
    if [ -n "${1:-}" ]; then
        [ -e "/sys/class/net/$1" ] || die "интерфейса $1 нет (wifi dev)"
        echo "$1"; return 0
    fi
    local n
    n=$(wl_list | head -1)
    [ -n "$n" ] || return 1
    echo "$n"
}

require_wl() {
    load_stack
    local n=""
    if ! n=$(wl_pick "${1:-}"); then n=""; fi
    if [ -z "$n" ]; then
        local w="${WIFI_WAIT:-12}"
        case "$w" in ''|*[!0-9]*) w=12 ;; esac
        local i=0
        while [ "$i" -lt "$w" ]; do
            i=$((i+1))
            [ "$i" -eq 1 ] && say "[wifi] интерфейса пока нет - жду до ${w} с перечисления USB (WIFI_WAIT=0 - не ждать)..." >&2
            sleep 1
            if ! n=$(wl_pick "${1:-}"); then n=""; fi
            [ -n "$n" ] && { ok "беспроводной интерфейс появился через ${i} с ожидания" >&2; break; }
        done
    fi
    if [ -z "$n" ]; then
        warn "беспроводной интерфейс не найден (ожидание перечисления USB: ${WIFI_WAIT:-12} с)."
        say "  1) адаптер воткнут в разъём на месте WiFi-модуля?  usbnet host" >&2
        say "  2) драйвер загрузился?                         lsmod; dmesg | tail -30" >&2
        say "  3) чего не хватает:                            wifi dev;  wifi fw" >&2
        return 1
    fi
    echo "$n"
}

drv_of() {
    local d
    d=$(readlink -f "/sys/class/net/$1/device/driver" 2>/dev/null || true)
    [ -n "$d" ] && basename "$d" || echo "?"
}

usb_id_of() {
    local p
    p=$(readlink -f "/sys/class/net/$1/device" 2>/dev/null || true)
    while [ -n "$p" ] && [ "$p" != "/" ]; do
        if [ -f "$p/idVendor" ] && [ -f "$p/idProduct" ]; then
            echo "$(cat "$p/idVendor"):$(cat "$p/idProduct")"
            return 0
        fi
        p=$(dirname "$p")
    done
    echo "?"
}

apply_reg() {
    local cc=""
    [ -f "$REG_FILE" ] && cc=$(head -1 "$REG_FILE" | tr -dc 'A-Za-z')
    [ -n "$cc" ] || return 0
    iw reg set "$cc" >/dev/null 2>&1 || true
    if [ -f "$CONF" ] && ! grep -q "^country=" "$CONF"; then
        sed -i "1i country=$cc" "$CONF" 2>/dev/null || true
    fi
}

ensure_conf() {
    mkdir -p "$CONF_DIR" "$RUN" "$CTRL_DIR" /var/log
    if [ ! -f "$CONF" ]; then
        cat > "$CONF" <<EOF
# создан утилитой wifi. Сети добавляет 'wifi connect <SSID> <пароль>'.
ctrl_interface=$CTRL_DIR
ctrl_interface_group=0
update_config=1
ap_scan=1
EOF
        chmod 600 "$CONF"
    else
        grep -q "^ctrl_interface=$CTRL_DIR$" "$CONF" || \
            sed -i "s|^ctrl_interface=.*|ctrl_interface=$CTRL_DIR|" "$CONF"
        grep -q '^ctrl_interface=' "$CONF" || sed -i "1i ctrl_interface=$CTRL_DIR" "$CONF"
    fi
}

# ------------------------------------------------------------- wpa_cli/состояние
wcli() {
    _wifc=$1; shift
    wpa_cli -p "$CTRL_DIR" -i "$_wifc" "$@" 2>/dev/null
}
wpa_state() { wcli "$1" status | awk -F= '/^wpa_state=/{print $2; exit}'; }
wpa_ssid()  { wcli "$1" status | awk -F= '/^ssid=/{print $2; exit}'; }

assoc_ok() {
    _aifc=$1
    [ "$(wpa_state "$_aifc")" = COMPLETED ] && return 0
    grep -q 'CTRL-EVENT-CONNECTED' "$LOG" 2>/dev/null && return 0
    grep -q 'WPA: Key negotiation completed' "$LOG" 2>/dev/null && return 0
    iw dev "$_aifc" link 2>/dev/null | grep -q 'Connected to' && return 0
    return 1
}

# ---------------------------------------------------------------- wifi dev
cmd_dev() {
    load_stack
    say "=== USB-устройства (адаптер ищется здесь) ==="
    if command -v lsusb >/dev/null 2>&1; then
        lsusb 2>/dev/null | sed 's/^/  /'
    else
        for d in /sys/bus/usb/devices/*; do
            [ -e "$d/idVendor" ] || continue
            say "  $(basename "$d")  $(cat "$d/idVendor"):$(cat "$d/idProduct")  $(cat "$d/product" 2>/dev/null)"
        done
    fi
    say ""
    say "=== беспроводные интерфейсы ==="
    local n=0
    for i in $(wl_list); do
        n=$((n+1))
        say "  $i: драйвер $(drv_of "$i"), USB $(usb_id_of "$i")"
        local s m op
        s=$(iw dev "$i" info 2>/dev/null | awk '/type/{print $2; exit}')
        m=$(cat "/sys/class/net/$i/address" 2>/dev/null || true)
        op=$(cat "/sys/class/net/$i/operstate" 2>/dev/null || true)
        say "       тип ${s:-?}, MAC ${m:-?}, состояние ${op:-?}"
        ip -4 -o addr show dev "$i" 2>/dev/null | awk '{print "       адрес " $4}'
        [ -f "$RUN/wpa.$i.pid" ] && kill -0 "$(cat "$RUN/wpa.$i.pid")" 2>/dev/null \
            && say "       wpa_supplicant: запущен (pid $(cat "$RUN/wpa.$i.pid"))"
    done
    [ "$n" = 0 ] && say "  (нет) - драйвер адаптера не загрузился или адаптер не воткнут"
    say ""
    say "=== загруженные беспроводные модули ==="
    lsmod 2>/dev/null | awk 'NR==1 || /cfg80211|mac80211|88x2bu|8812|8821|8822|rtw88|rtw89|rt2|rtl|r8712|mt76|ath|carl9170|zd1211|p54|mwifiex|rsi|brcm|vnt|at76|rfkill|libarc4/' | sed 's/^/  /'
    say ""
    say "=== прошивки: чего ядру не хватило ==="
    local miss
    miss=$(dmesg 2>/dev/null | grep -iE 'direct firmware load|failed to load firmware|firmware: failed|could not load firmware|no firmware' | tail -8)
    if [ -n "$miss" ]; then
        echo "$miss" | sed 's/^/  /'
        say "  -> нужный файл можно положить в /lib/firmware (см. 'wifi fw')"
    else
        say "  жалоб на отсутствие прошивок в dmesg нет"
    fi
    say ""
    say "=== последние строки dmesg про USB/WiFi ==="
    dmesg 2>/dev/null | grep -iE 'usb [0-9]-|new high-speed|new full-speed|wlan|wlx|88x2bu|rtw_|rtl88|cfg80211|mac80211|firmware' | tail -12 | sed 's/^/  /'
}

# ---------------------------------------------------------------- wifi scan
cmd_scan() {
    local ifc
    ifc=$(require_wl "${1:-}") || return 1
    say "сканирую на $ifc (2.4 / 5 ГГц, 3-10 с, адаптер не должен быть занят)..."
    ip link set "$ifc" up 2>/dev/null || true
    local out
    out=$(iw dev "$ifc" scan 2>&1)
    case "$out" in
        *"command failed: Device or resource busy"*|*"busy"*)
            warn "интерфейс занят (подключён?). Сначала: wifi down"; return 1 ;;
        *"Interface doesn't exist"*|*"No such device"*)
            die "нет устройства $ifc" ;;
        *"command failed"*)
            say "$out" | head -3 | sed 's/^/  /'
            warn "скан не удался. Смотрите 'wifi dev' и dmesg."
            return 1 ;;
    esac
    echo "$out" | awk '
        function flushbss() {
            if (bssid == "") return
            sec = "open"
            if (rsn) sec = "WPA2"
            else if (wpa) sec = "WPA"
            else if (privacy) sec = "WEP"
            if (rsn && wpa) sec = "WPA/WPA2"
            printf "%6.1f дБм  %-4s ch%-3s %-10s %-17s %-32s %s\n", sig, band, ch, sec, bssid, (ssid == "" ? "<скрытая сеть>" : ssid), extra
            bssid=""; ssid=""; sig=0; ch=""; band=""; wpa=0; rsn=0; privacy=0; extra=""
        }
        /^BSS /              { flushbss(); bssid = substr($2, 1, 17) }
        /^[ \t]*freq:/       {
            f = $2 + 0
            if (f > 2400000) f = f / 1000
            if (f == 2484) { ch = 14; band = "2.4G" }
            else if (f >= 2412 && f < 2500) { ch = int((f - 2407) / 5 + 0.5); band = "2.4G" }
            else if (f >= 4900 && f < 5900) { ch = int((f - 5000) / 5 + 0.5); band = "5G" }
            else { ch = int(f); band = "?" }
        }
        /^[ \t]*signal:/     { sig = $2 }
        /^[ \t]*SSID:/       { ssid = substr($0, index($0, ":") + 2) }
        /^[ \t]*capability:/ { if ($0 ~ /Privacy/) privacy = 1 }
        /^[ \t]*WPA:/        { wpa = 1 }
        /^[ \t]*RSN:/        { rsn = 1 }
        END { flushbss() }
    ' | sort -rn | head -40
    say ""
    say "подключение:  wifi connect '<SSID>' '<пароль>' [$ifc]"
}

# ---------------------------------------------------------------- wpa_supplicant
wpa_running() { local ifc="$1"; [ -f "$RUN/wpa.$ifc.pid" ] && kill -0 "$(cat "$RUN/wpa.$ifc.pid")" 2>/dev/null; }
ap_running()  { local ifc="$1"; [ -f "$RUN/hostapd.$ifc.pid" ] && kill -0 "$(cat "$RUN/hostapd.$ifc.pid")" 2>/dev/null; }

stop_wpa() {
    local ifc="$1" pid=""
    if [ -f "$RUN/wpa.$ifc.pid" ]; then
        kill "$(cat "$RUN/wpa.$ifc.pid" 2>/dev/null)" 2>/dev/null || true
        rm -f "$RUN/wpa.$ifc.pid"
    fi
    pid=$(wpa_find_pid "$ifc" 2>/dev/null || true)
    [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
    rm -f "$CTRL_DIR/$ifc" 2>/dev/null || true
}

WPA_F=""
wpa_supports_f() {
    [ -n "$WPA_F" ] && return 0
    case "$(wpa_supplicant -h 2>&1)" in
        *"  -f ="*) WPA_F=1 ;;
        *)          WPA_F=0 ;;
    esac
}

wpa_find_pid() {
    for p in /proc/[0-9]*; do
        local c
        c=$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null) || continue
        case "$c" in
            *wpa_supplicant*" -i $1 "*|*wpa_supplicant*" -i $1") echo "${p#/proc/}"; return 0 ;;
        esac
    done
    return 1
}

start_wpa() {
    local ifc="$1" cfg="${2:-$CONF}"
    local ilog="/var/log/wifi-${ifc}.log"
    mkdir -p "$RUN" /var/log "$CTRL_DIR"
    rm -f "$RUN/wpa.$ifc.pid"
    : > "$ilog" 2>/dev/null || true
    ln -sfn "$ilog" "$LOG" 2>/dev/null || true
    wpa_supports_f
    if [ "$WPA_F" = 1 ]; then
        wpa_supplicant -B -P "$RUN/wpa.$ifc.pid" -i "$ifc" -c "$cfg" \
            -D nl80211,wext -f "$ilog" >>"$ilog" 2>&1
    elif command -v setsid >/dev/null 2>&1; then
        setsid wpa_supplicant -i "$ifc" -c "$cfg" -D nl80211,wext >>"$ilog" 2>&1 &
    else
        wpa_supplicant -i "$ifc" -c "$cfg" -D nl80211,wext >>"$ilog" 2>&1 &
    fi
    local i=0 pid=""
    while [ "$i" -lt 5 ]; do
        i=$((i+1))
        [ -s "$RUN/wpa.$ifc.pid" ] && break
        pid=$(wpa_find_pid "$ifc") && { echo "$pid" > "$RUN/wpa.$ifc.pid"; break; }
        sleep 1
    done
    if ! wpa_running "$ifc"; then
        warn "wpa_supplicant на $ifc не запустился. Последние строки $ilog:"
        tail -12 "$ilog" 2>/dev/null | sed 's/^/    /'
        return 1
    fi
    ok "wpa_supplicant на $ifc запущен (pid $(cat "$RUN/wpa.$ifc.pid" 2>/dev/null)), лог: $ilog"
    return 0
}

diag_no_assoc() {
    tail -15 "$LOG" 2>/dev/null | sed 's/^/    /'
    if grep -qE '4WAY_HANDSHAKE_TIMEOUT|WRONG_KEY|CTRL-EVENT-DISCONNECTED.*reason=2|pre-shared key may be wrong' "$LOG" 2>/dev/null; then
        warn "похоже на НЕВЕРНЫЙ ПАРОЛЬ: повторите  wifi connect '<SSID>' '<настоящий пароль>'"
    elif grep -q 'Trying to associate\|associating' "$LOG" 2>/dev/null && ! grep -q 'Associated' "$LOG" 2>/dev/null; then
        warn "точка доступа не отвечает на попытку ассоциации: слабый сигнал, занят канал или фильтр по MAC"
    elif grep -qE 'SSID not found|no suitable AP found' "$LOG" 2>/dev/null; then
        warn "сеть не видна: проверьте SSID, канал 12-13 (wifi reg RU) и wifi scan"
    fi
    say "  полный лог: wifi log 80"
}

NETBLK_RE='^network[ =]*[{]'

have_saved_nets() {
    [ -f "$CONF" ] || return 1
    grep -q -- "$NETBLK_RE" "$CONF" 2>/dev/null
}

count_saved_nets() {
    [ -f "$CONF" ] || { echo 0; return 0; }
    local n
    n=$(grep -c -- "$NETBLK_RE" "$CONF" 2>/dev/null || true)
    echo "${n:-0}"
}

list_saved_nets() {
    [ -f "$CONF" ] || { say "  (конфига $CONF нет)"; return 0; }
    awk -F'"' '/^[ \t]*ssid[ \t]*=/ { if (NF >= 2 && $2 != "") print "  - " $2; else print "  - " $0 }' "$CONF" 2>/dev/null
}

net_block_del() {
    local ssid="$1"
    [ -f "$CONF" ] || return 0
    awk -v want="$ssid" '
        BEGIN { inblk = 0 }
        /^[ \t]*network[ \t=]*\{/ { inblk = 1; buf = $0 "\n"; ismatch = 0; next }
        inblk {
            buf = buf $0 "\n"
            if ($0 ~ /^[ \t]*ssid[ \t]*=/) {
                v = $0
                sub(/^[ \t]*ssid[ \t]*=[ \t]*"?/, "", v)
                sub(/"?[ \t]*$/, "", v)
                if (v == want) ismatch = 1
            }
            if ($0 ~ /^[ \t]*\}/) { if (!ismatch) printf "%s", buf; inblk = 0 }
            next
        }
        { print }
        END { if (inblk) printf "%s", buf }
    ' "$CONF" > "$CONF.new" && mv "$CONF.new" "$CONF"
    chmod 600 "$CONF"
}

ip4_of() { ip -4 -o addr show dev "$1" 2>/dev/null | awk '{print $4}' | head -1; }

dhcp_stop() {
    local ifc="$1"
    if [ -f "$RUN/dhclient.$ifc.pid" ]; then
        dhclient -4 -r -pf "$RUN/dhclient.$ifc.pid" -lf "$RUN/dhclient.$ifc.leases" "$ifc" >/dev/null 2>&1 || true
        kill "$(cat "$RUN/dhclient.$ifc.pid" 2>/dev/null)" 2>/dev/null || true
        rm -f "$RUN/dhclient.$ifc.pid"
    fi
}

dhcp_up() {
    local ifc="$1"
    mkdir -p "$RUN"
    dhcp_stop "$ifc"
    ip -4 addr flush dev "$ifc" 2>/dev/null || true
    ip link set "$ifc" up 2>/dev/null || true
    # Стандартный DHCP-клиент Debian (isc-dhcp-client): получает IP, маршрут и DNS,
    # затем уходит в фон для продления аренды.
    timeout 25 dhclient -4 -pf "$RUN/dhclient.$ifc.pid" -lf "$RUN/dhclient.$ifc.leases" "$ifc" >/dev/null 2>&1 || true
    local a
    a=$(ip4_of "$ifc")
    if [ -n "$a" ]; then
        local g
        g=$(ip route 2>/dev/null | awk '/^default/{print $3; exit}')
        ok "$ifc получил адрес $a (шлюз ${g:-?})"
        say "  DNS: $(awk '/^nameserver/{printf "%s ", $2}' /etc/resolv.conf 2>/dev/null)"
        return 0
    fi
    warn "DHCP-адрес не получен"
    if assoc_ok "$ifc"; then
        say "  ассоциация с точкой есть - повторите: wifi dhcp  или  wifi static 192.168.1.50/24 192.168.1.1 1.1.1.1"
    else
        say "  ассоциации нет - сначала  wifi connect '<SSID>' '<пароль>'"
    fi
    return 1
}

static_get() {
    [ -f "$STATIC_FILE" ] || return 0
    awk -v i="$1" '$1==i{print $2, $3, $4; exit}' "$STATIC_FILE"
}

have_ip() {
    local ifc="$1"
    local sc
    sc=$(static_get "$ifc")
    if [ -n "$sc" ]; then
        # shellcheck disable=SC2086
        set -- $sc
        dhcp_stop "$ifc"
        ip -4 addr flush dev "$ifc" 2>/dev/null || true
        ip link set "$ifc" up 2>/dev/null || true
        ip addr add "$1" dev "$ifc" 2>/dev/null || { warn "не назначить $1"; return 1; }
        [ -n "${2:-}" ] && ip route replace default via "$2" dev "$ifc" 2>/dev/null || true
        [ -n "${3:-}" ] && printf 'nameserver %s\n' "$3" > /etc/resolv.conf
        ok "$ifc: статический адрес $1${2:+, шлюз $2}${3:+, DNS $3} (из $STATIC_FILE)"
        return 0
    fi
    dhcp_up "$ifc"
}

cmd_dhcp() {
    need_root
    local ifc
    ifc=$(require_wl "${1:-}") || return 1
    load_stack
    assoc_ok "$ifc" || warn "ассоциации с точкой нет - DHCP может не ответить"
    dhcp_up "$ifc"
}

cmd_static() {
    need_root
    local ifc
    ifc=$(require_wl "${3:-}") || return 1
    case "${1:-}" in
        ""|off|help)
            dhcp_stop "$ifc"
            ip -4 addr flush dev "$ifc" 2>/dev/null || true
            ip route del default dev "$ifc" 2>/dev/null || true
            if [ -f "$STATIC_FILE" ]; then
                awk -v i="$ifc" '$1!=i' "$STATIC_FILE" > "$STATIC_FILE.new" && mv "$STATIC_FILE.new" "$STATIC_FILE"
                [ -s "$STATIC_FILE" ] || rm -f "$STATIC_FILE"
            fi
            ok "$ifc: статический адрес снят (дальше - wifi dhcp)"
            return 0 ;;
    esac
    local ipmask="$1" gw="${2:-}" dns="${3:-}"
    case "$ipmask" in */*) ;; *) ipmask="$ipmask/24" ;; esac
    printf '%s %s %s %s\n' "$ifc" "$ipmask" "$gw" "$dns" > "$STATIC_FILE"
    chmod 644 "$STATIC_FILE"
    have_ip "$ifc" || return 1
    say "  настройка сохранена в $STATIC_FILE и применяется при каждой загрузке"
}

# ------------------------------------------------------- мощность передатчика
tx_now() {
    local t
    t=$(iw dev "$1" info 2>/dev/null | awk '/txpower/{print $(NF-1); exit}')
    if [ -z "$t" ] && command -v iwconfig >/dev/null 2>&1; then
        t=$(iwconfig "$1" 2>/dev/null | sed -n 's/.*Tx-Power[=:]\([0-9.]*\).*/\1/p' | head -1)
    fi
    echo "${t:-?}"
}

set_tx_dbm() {
    local ifc="$1" v="$2"
    ip link set "$ifc" up 2>/dev/null || true
    iw dev "$ifc" set txpower fixed $(( v * 100 )) 2>/dev/null && return 0
    iw dev "$ifc" set txpower limit $(( v * 100 )) 2>/dev/null && return 0
    if command -v iwconfig >/dev/null 2>&1; then
        iwconfig "$ifc" txpower "${v}dBm" 2>/dev/null && return 0
    fi
    return 1
}

apply_tx() {
    local ifc="$1"
    [ -f "$TX_FILE" ] || return 0
    local v
    v=$(head -1 "$TX_FILE" 2>/dev/null | tr -dc '0-9')
    [ -n "$v" ] || return 0
    if set_tx_dbm "$ifc" "$v"; then
        say "  мощность передатчика: ${v} дБм (ограничение из $TX_FILE)"
    fi
}

cmd_tx() {
    need_root
    local ifc
    ifc=$(require_wl "${2:-}") || return 1
    case "${1:-status}" in
        status|"")
            say "текущая мощность $ifc: $(tx_now "$ifc") дБм"
            say "сохранённое ограничение: $([ -f "$TX_FILE" ] && cat "$TX_FILE" || echo 'нет (полная мощность)')"
            say "  wifi tx 5 [$ifc]    - 5 дБм (минимум тока передатчика при слабом USB-питании)"
            say "  wifi tx 10 [$ifc]   - 10 дБм"
            say "  wifi tx max [$ifc]  - снять ограничение"
            return 0 ;;
        max|auto|off)
            rm -f "$TX_FILE"
            iw dev "$ifc" set txpower auto 2>/dev/null \
                || { command -v iwconfig >/dev/null 2>&1 && iwconfig "$ifc" txpower auto 2>/dev/null; } \
                || true
            ok "$ifc: мощность по умолчанию (auto), $(tx_now "$ifc") дБм"
            return 0 ;;
    esac
    local v
    v=$(printf '%s' "$1" | tr -dc '0-9')
    [ -n "$v" ] || { warn "нужно число дБм (например: wifi tx 5)"; return 1; }
    [ "$v" -ge 1 ] && [ "$v" -le 30 ] || { warn "допустимо 1..30 дБм"; return 1; }
    set_tx_dbm "$ifc" "$v" \
        || warn "драйвер $ifc не принял фиксированную мощность ${v} дБм (проверьте регуляторный лимит: wifi reg)"
    echo "$v" > "$TX_FILE"
    ok "$ifc: мощность ${v} дБм, сохранено в $TX_FILE"
}

cmd_ps() {
    need_root
    local ifc
    ifc=$(require_wl "${2:-}") || return 1
    case "${1:-status}" in
        status|"")
            say "power save $ifc: $(iw dev "$ifc" get power_save 2>/dev/null | awk '{print $NF}')"
            say "  wifi ps off - выключить (стабильнее на некоторых драйверах)"
            say "  wifi ps on  - включить" ;;
        on)  iw dev "$ifc" set power_save on  2>/dev/null && ok "$ifc: power save ВКЛ" ;;
        off) iw dev "$ifc" set power_save off 2>/dev/null && ok "$ifc: power save ВЫКЛ" ;;
        *)   warn "использование: wifi ps on|off|status" ;;
    esac
}

stop_ap_ifc() {
    local ifc="$1"
    if [ -f "$RUN/hostapd.$ifc.pid" ]; then
        kill "$(cat "$RUN/hostapd.$ifc.pid" 2>/dev/null)" 2>/dev/null || true
        rm -f "$RUN/hostapd.$ifc.pid"
    fi
    if [ -f "$RUN/dnsmasq-ap.$ifc.pid" ]; then
        kill "$(cat "$RUN/dnsmasq-ap.$ifc.pid" 2>/dev/null)" 2>/dev/null || true
        rm -f "$RUN/dnsmasq-ap.$ifc.pid" "$RUN/dnsmasq-ap.$ifc.leases"
    fi
    rm -f "$RUN/active-role.$ifc" 2>/dev/null || true
}

cmd_connect() {
    need_root
    local ssid="${1:-}" pass="${2:-}"
    [ -n "$ssid" ] || { say "использование: wifi connect '<SSID>' '<пароль>' [iface]"; return 1; }
    local ifc
    ifc=$(require_wl "${3:-}") || return 1
    ensure_conf; apply_reg
    ok "подключаю $ifc к '$ssid'"
    stop_ap_ifc "$ifc"
    stop_wpa "$ifc"
    ip link set "$ifc" down 2>/dev/null || true
    iw dev "$ifc" set type managed 2>/dev/null || true
    net_block_del "$ssid"
    if [ -n "$pass" ]; then
        if command -v wpa_passphrase >/dev/null 2>&1; then
            wpa_passphrase "$ssid" "$pass" >> "$CONF" 2>/dev/null
        else
            printf 'network={\n\tssid="%s"\n\tpsk="%s"\n}\n' "$ssid" "$pass" >> "$CONF"
        fi
    else
        printf 'network={\n\tssid="%s"\n\tkey_mgmt=NONE\n}\n' "$ssid" >> "$CONF"
    fi
    chmod 600 "$CONF"
    ip link set "$ifc" up 2>/dev/null || true
    apply_tx "$ifc"
    start_wpa "$ifc" || { diag_no_assoc; return 1; }
    say "  жду ассоциации (до 40 с)..."
    local i=0 state="" ilog="/var/log/wifi-${ifc}.log"
    while [ "$i" -lt 40 ]; do
        i=$((i+1))
        assoc_ok "$ifc" && break
        state=$(wpa_state "$ifc")
        wpa_running "$ifc" || { state="${state:-wpa_supplicant завершился}"; break; }
        if [ "$i" -gt 8 ] && grep -qE '4WAY_HANDSHAKE_TIMEOUT|WRONG_KEY|pre-shared key may be wrong' "$ilog" 2>/dev/null; then
            state="неверный пароль"; break
        fi
        sleep 1
    done
    if assoc_ok "$ifc"; then
        local ssid_now sig
        ssid_now=$(wpa_ssid "$ifc")
        sig=$(iw dev "$ifc" link 2>/dev/null | awk '/signal:/{print $2, $3; exit}')
        ok "подключено к '${ssid_now:-$ssid}'${sig:+, сигнал $sig} (за ${i} с)"
        have_ip "$ifc"
        say "  сеть сохранена в $CONF; для нескольких адаптеров (STA + AP): wifi-config"
        return 0
    fi
    say "  состояние: ${state:-не подключено} (через ${i} с)"
    warn "не подключилось. Диагностика ниже:"
    diag_no_assoc
    return 1
}

# --- Поддержка многоадаптерных профилей /etc/informer701-wifi/profiles/*.conf ---
MULTI_DIR="/etc/informer701-wifi"
MULTI_PROFS="$MULTI_DIR/profiles"

have_multi_profiles() {
    [ -d "$MULTI_PROFS" ] || return 1
    local f
    for f in "$MULTI_PROFS"/*.conf; do
        [ -f "$f" ] && return 0
    done
    return 1
}

mprof_get() {
    awk -v k="$2" 'index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$1" 2>/dev/null
}

sync_ap_nat_ifc() {
    local ap_ifc="$1"
    local gw
    gw=$(ip route 2>/dev/null | awk -v cur="$ap_ifc" '/^default/ && $5 != cur {print $5; exit}')
    [ -n "$gw" ] && command -v iptables >/dev/null 2>&1 || return 0
    echo 1 > /proc/sys/net/ipv4/ip_forward 2>/dev/null || true
    iptables -t nat -C POSTROUTING -o "$gw" -j MASQUERADE 2>/dev/null \
        || iptables -t nat -A POSTROUTING -o "$gw" -j MASQUERADE
    iptables -C FORWARD -i "$ap_ifc" -o "$gw" -j ACCEPT 2>/dev/null \
        || iptables -A FORWARD -i "$ap_ifc" -o "$gw" -j ACCEPT
    iptables -C FORWARD -i "$gw" -o "$ap_ifc" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
        || iptables -A FORWARD -i "$gw" -o "$ap_ifc" -m state --state RELATED,ESTABLISHED -j ACCEPT
}

apply_sta_profile() {
    local ifc="$1" pf="$2" wait_sec="${3:-30}"
    local id ssid ipm sip sgw sdns wcfg
    id=$(mprof_get "$pf" ID)
    ssid=$(mprof_get "$pf" STA_SSID)
    ipm=$(mprof_get "$pf" STA_IP_MODE)
    sip=$(mprof_get "$pf" STA_IP)
    sgw=$(mprof_get "$pf" STA_GW)
    sdns=$(mprof_get "$pf" STA_DNS)
    wcfg="$MULTI_DIR/wpa-${id}.conf"
    [ -f "$wcfg" ] || /usr/local/bin/wifi-config gen-wpa "$pf"

    stop_ap_ifc "$ifc"
    if ! wpa_running "$ifc"; then
        ip link set "$ifc" down 2>/dev/null || true
        iw dev "$ifc" set type managed 2>/dev/null || true
        ip link set "$ifc" up 2>/dev/null || true
        apply_tx "$ifc"
        start_wpa "$ifc" "$wcfg" || return 1
    fi

    local i=0
    while [ "$i" -lt "$wait_sec" ]; do
        assoc_ok "$ifc" && break
        wpa_running "$ifc" || break
        i=$((i + 1))
        sleep 1
    done
    echo "sta:$id" > "$RUN/active-role.$ifc"
    if assoc_ok "$ifc"; then
        ok "$ifc (профиль $id) подключён к '${ssid}'"
        if [ "$ipm" = "static" ] && [ -n "$sip" ]; then
            dhcp_stop "$ifc"
            ip -4 addr flush dev "$ifc" 2>/dev/null || true
            ip addr add "$sip" dev "$ifc" 2>/dev/null || true
            [ -n "$sgw" ] && ip route replace default via "$sgw" dev "$ifc" 2>/dev/null || true
            [ -n "$sdns" ] && printf 'nameserver %s\n' "$sdns" > /etc/resolv.conf
        else
            [ -n "$(ip4_of "$ifc")" ] || dhcp_up "$ifc" || true
        fi
        return 0
    fi
    warn "$ifc (профиль $id): пока нет ассоциации с '$ssid' (фоновый повтор активен)"
    return 0
}

apply_ap_profile() {
    local ifc="$1" pf="$2"
    local id ssid ch ap_cidr ap_ip ap_net nat hcfg
    id=$(mprof_get "$pf" ID)
    ssid=$(mprof_get "$pf" AP_SSID)
    ch=$(mprof_get "$pf" AP_CHANNEL)
    ap_cidr=$(mprof_get "$pf" AP_IP)
    nat=$(mprof_get "$pf" AP_NAT)
    [ -n "$ap_cidr" ] || ap_cidr="192.168.71.1/24"
    ap_ip="${ap_cidr%/*}"
    ap_net="${ap_ip%.*}"

    command -v hostapd >/dev/null 2>&1 || die "не установлен hostapd"
    stop_wpa "$ifc"
    dhcp_stop "$ifc"
    stop_ap_ifc "$ifc"

    hcfg=$(/usr/local/bin/wifi-config gen-hostapd "$pf" "$ifc")
    ip addr flush dev "$ifc" 2>/dev/null || true
    ip link set "$ifc" down 2>/dev/null || true
    ip link set "$ifc" up 2>/dev/null || true
    ip addr add "$ap_cidr" dev "$ifc" 2>/dev/null || true

    hostapd -B -P "$RUN/hostapd.$ifc.pid" "$hcfg" >/dev/null 2>&1 || {
        warn "hostapd не стартовал на $ifc (канал $ch; проверьте 'wifi reg RU' и диапазон адаптера)"
        return 1
    }
    ln -sfn "$RUN/hostapd.$ifc.pid" "$RUN/hostapd.pid" 2>/dev/null || true

    if command -v dnsmasq >/dev/null 2>&1; then
        dnsmasq --interface="$ifc" --except-interface=lo --bind-dynamic \
            --dhcp-range="${ap_net}.50,${ap_net}.150,255.255.255.0,12h" \
            --dhcp-option=3,"$ap_ip" --dhcp-option=6,"$ap_ip" --port=53 \
            --dhcp-leasefile="$RUN/dnsmasq-ap.$ifc.leases" \
            --pid-file="$RUN/dnsmasq-ap.$ifc.pid" >/dev/null 2>&1 || true
    fi
    echo "ap:$id" > "$RUN/active-role.$ifc"
    [ "${nat:-1}" = "1" ] && sync_ap_nat_ifc "$ifc"
    ok "точка доступа '$ssid' поднята на $ifc (к.$ch, $ap_cidr${nat:+, NAT=$nat})"
    return 0
}

cmd_apply() {
    need_root
    load_stack; apply_reg
    if ! have_multi_profiles; then
        cmd_up
        return $?
    fi

    local expected actual w=0
    expected=$(ls -1 "$MULTI_PROFS"/*.conf 2>/dev/null | wc -l | tr -d ' ')
    while [ "$w" -lt "${WIFI_WAIT:-12}" ]; do
        actual=$(wl_count)
        [ "$actual" -ge "$expected" ] && break
        [ "$w" -eq 0 ] && say "[wifi] ожидаю перечисления USB Wi-Fi адаптеров ($actual из $expected)..."
        sleep 1
        w=$((w + 1))
    done

    local pairs line ifc pf id role any=0
    pairs=$(/usr/local/bin/wifi-config match)
    if [ -z "$pairs" ]; then
        warn "ни один из настроенных в wifi-config адаптеров сейчас не подключён"
        return 1
    fi

    # Сначала поднимаем все клиентские STA-адаптеры (чтобы появился маршрут в интернет),
    # затем поднимаем все точки доступа AP и включаем NAT между ними!
    while read -r ifc pf id role; do
        [ -n "$ifc" ] && [ "$role" = "sta" ] || continue
        any=1
        apply_sta_profile "$ifc" "$pf" 30 || true
    done <<< "$pairs"

    while read -r ifc pf id role; do
        [ -n "$ifc" ] && [ "$role" = "ap" ] || continue
        any=1
        apply_ap_profile "$ifc" "$pf" || true
    done <<< "$pairs"

    [ "$any" -eq 1 ]
}

cmd_up() {
    need_root
    if have_multi_profiles; then
        cmd_apply
        return $?
    fi
    local ifc
    ifc=$(require_wl "") || return 1
    ensure_conf; apply_reg
    if ! have_saved_nets; then
        warn "в $CONF нет ни одной сохранённой сети - выполните 'wifi connect <SSID> <пароль>' или 'wifi-config'"
        return 1
    fi
    if wpa_running "$ifc"; then
        ok "wpa_supplicant уже работает на $ifc"
    else
        ip link set "$ifc" up 2>/dev/null || true
        apply_tx "$ifc"
        start_wpa "$ifc" || return 1
    fi
    local i=0
    while [ "$i" -lt 45 ]; do
        i=$((i+1))
        assoc_ok "$ifc" && break
        wpa_running "$ifc" || break
        sleep 1
    done
    if assoc_ok "$ifc"; then
        ok "$ifc подключён к '$(wpa_ssid "$ifc")' (за ${i} с)"
        [ -n "$(ip4_of "$ifc")" ] || have_ip "$ifc"
        ip4_of "$ifc" | sed '/./s/^/[wifi] адрес: /'
        return 0
    fi
    warn "не подключилось за ${i} с (состояние $(wpa_state "$ifc"))"
    diag_no_assoc
    return 1
}

cmd_daemon() {
    need_root
    trap 'cmd_down; exit 0' TERM INT
    if have_multi_profiles; then
        load_stack; apply_reg
        cmd_apply || true
        while :; do
            sleep 10
            local pairs ifc pf id role
            pairs=$(/usr/local/bin/wifi-config match 2>/dev/null || true)
            [ -n "$pairs" ] || continue
            while read -r ifc pf id role; do
                [ -n "$ifc" ] || continue
                case "$role" in
                    sta)
                        if ! wpa_running "$ifc"; then
                            apply_sta_profile "$ifc" "$pf" 15 || true
                        elif assoc_ok "$ifc" && [ "$(mprof_get "$pf" STA_IP_MODE)" != "static" ] && [ -z "$(ip4_of "$ifc")" ]; then
                            dhcp_up "$ifc" || true
                        fi
                        ;;
                    ap)
                        if ! ap_running "$ifc"; then
                            apply_ap_profile "$ifc" "$pf" || true
                        elif [ "$(mprof_get "$pf" AP_NAT)" = "1" ]; then
                            sync_ap_nat_ifc "$ifc"
                        fi
                        ;;
                esac
            done <<< "$pairs"
        done
    fi

    cmd_up || exit 1
    local ifc
    ifc=$(wl_pick "" || echo "wlan0")
    while :; do
        sleep 10
        wpa_running "$ifc" || die "wpa_supplicant на $ifc завершился - перезапуск службы"
    done
}

cmd_down() {
    need_root
    for ifc in $(wl_list); do
        stop_wpa "$ifc"
        dhcp_stop "$ifc"
        stop_ap_ifc "$ifc"
        ip addr flush dev "$ifc" 2>/dev/null || true
        ip route del default dev "$ifc" 2>/dev/null || true
        ip link set "$ifc" down 2>/dev/null || true
        iw dev "$ifc" set type managed 2>/dev/null || true
        ok "$ifc: остановлены службы STA/AP, адрес снят"
    done
    [ -f "$RUN/hostapd.pid" ] && { kill "$(cat "$RUN/hostapd.pid" 2>/dev/null)" 2>/dev/null || true; rm -f "$RUN/hostapd.pid"; }
    [ -f "$RUN/dnsmasq-ap.pid" ] && { kill "$(cat "$RUN/dnsmasq-ap.pid" 2>/dev/null)" 2>/dev/null || true; rm -f "$RUN/dnsmasq-ap.pid"; }
    [ -n "$(wl_list)" ] || say "беспроводных интерфейсов нет"
}

cmd_status() {
    load_stack
    say "=== WiFi ==="
    say "  страна: $(cat "$REG_FILE" 2>/dev/null || echo 'не задана (iw reg get)')   автоподключение: $([ -f "$AUTO_FLAG" ] && echo ВКЛ || echo выкл)"
    say "  сохранено сетей ($CONF): $(count_saved_nets)   профилей адаптеров (wifi-config): $(ls -1 "$MULTI_PROFS"/*.conf 2>/dev/null | wc -l | tr -d ' ')"
    for ifc in $(wl_list); do
        say "  --- $ifc: драйвер $(drv_of "$ifc"), MAC $(cat "/sys/class/net/$ifc/address" 2>/dev/null || echo '?'), USB $(usb_id_of "$ifc")"
        if ap_running "$ifc"; then
            local ap_ssid ap_ch
            ap_ssid=$(iw dev "$ifc" info 2>/dev/null | awk '/ssid/{print $2; exit}')
            ap_ch=$(iw dev "$ifc" info 2>/dev/null | awk '/channel/{print $2; exit}')
            say "      режим:         ТОЧКА ДОСТУПА (hostapd pid $(cat "$RUN/hostapd.$ifc.pid" 2>/dev/null), SSID '${ap_ssid:-?}', канал ${ap_ch:-?})"
        else
            local st
            st=$(wcli "$ifc" status)
            if [ -n "$st" ]; then
                echo "$st" | awk -F= '/^(ssid|bssid|freq|key_mgmt|pairwise_cipher|group_cipher|wpa_state|ip_address)=/{printf "      %-17s %s\n", $1":", $2}'
            else
                say "      wpa_supplicant не запущен"
            fi
            iw dev "$ifc" link 2>/dev/null | sed -n '2,6p' | sed 's/^/      /'
        fi
        local a
        a=$(ip4_of "$ifc")
        say "      адрес:         ${a:-НЕТ (IPv4)}"
        say "      состояние:     $(cat "/sys/class/net/$ifc/operstate" 2>/dev/null || true)"
    done
    say "  шлюз по умолчанию: $(ip route 2>/dev/null | awk '/^default/{print $3" ("$5")"; exit}')"
    say "  DNS: $(awk '/^nameserver/{printf "%s ", $2}' /etc/resolv.conf 2>/dev/null)"
    [ "$(wl_count)" = 0 ] && say "  беспроводных интерфейсов НЕТ - смотрите 'wifi dev'"
}

cmd_log() {
    [ -f "$LOG" ] || { say "$LOG нет"; return 0; }
    say "=== $LOG (последние ${1:-40} строк) ==="
    tail -"${1:-40}" "$LOG"
}

cmd_fw() {
    say "=== прошивки в /lib/firmware ==="
    if [ -d /lib/firmware ]; then
        say "  файлов: $(find -L /lib/firmware -type f | wc -l), объём: $(du -shL /lib/firmware | cut -f1)"
        find -L /lib/firmware -type f | sed 's|/lib/firmware/||' | sort | tr '\n' ' ' | fold -w 76 | sed 's/^/  /'
    else
        warn "/lib/firmware нет"
    fi
    say ""
    say "=== что просило ядро и не получило (dmesg) ==="
    local d
    d=$(dmesg 2>/dev/null | grep -iE 'firmware' | tail -12)
    [ -n "$d" ] && echo "$d" | sed 's/^/  /' || say "  ничего"
}

cmd_reg() {
    need_root; load_stack
    local cc
    cc=$(echo "${1:-}" | tr 'a-z' 'A-Z' | tr -dc 'A-Z')
    if [ -z "$cc" ]; then
        say "текущая страна: $(iw reg get 2>/dev/null | head -1)"
        say "сохранено в $REG_FILE: $(cat "$REG_FILE" 2>/dev/null || echo '-')"
        say "установить: wifi reg RU"
        return 0
    fi
    [ "${#cc}" -eq 2 ] || die "код страны - две буквы (RU, US, DE, ...)"
    if iw reg set "$cc" 2>/dev/null; then
        echo "$cc" > "$REG_FILE"
        sleep 1
        local cur
        cur=$(iw reg get 2>/dev/null | head -1)
        case "$cur" in
            *"country $cc"*)
                ok "страна $cc применена и сохранена ($REG_FILE)"
                iw reg get 2>/dev/null | head -4 | sed 's/^/  /' ;;
            *)
                warn "iw reg set принял $cc, но домен не сменился: $cur" ;;
        esac
    else
        warn "iw reg set $cc не сработал"
    fi
}

cmd_auto() {
    need_root
    case "${1:-status}" in
        on)
            touch "$AUTO_FLAG"
            if has_systemd && [ ! -e /etc/systemd/system/multi-user.target.wants/informer701-wifi.service ]; then
                systemctl enable informer701-wifi.service >/dev/null 2>&1 || true
            fi
            ok "автоподключение при загрузке ВКЛЮЧЕНО ($AUTO_FLAG)"
            ensure_conf
            have_saved_nets || have_multi_profiles || warn "нет сохранённых сетей - выполните wifi connect или wifi-config" ;;
        off)
            rm -f "$AUTO_FLAG"
            has_systemd && systemctl stop informer701-wifi.service >/dev/null 2>&1 || true
            ok "автоподключение выключено" ;;
        *)
            say "автоподключение: $([ -f "$AUTO_FLAG" ] && echo ВКЛЮЧЕНО || echo выключено)"
            say "сохранённые сети:"
            list_saved_nets ;;
    esac
}

# ------------------------------------------------------------- wifi selftest
cmd_selftest() {
    local rc=0 n=0 bad=0
    local t="${TMPDIR:-/tmp}/wifi-selftest.$$"
    local CONF_SAVE="$CONF"
    CONF="$t"
    st_ok()  { n=$((n+1)); say "  OK   $1"; }
    st_bad() { n=$((n+1)); bad=$((bad+1)); say "  FAIL $1"; rc=1; }
    st_eq()  { if [ "$2" = "$3" ]; then st_ok "$1 = $2"; else st_bad "$1: получено '$2', ожидалось '$3'"; fi; }

    say "wifi selftest: логика конфига (временный файл $t)"
    printf 'ctrl_interface=/var/run/wpa_supplicant\nupdate_config=1\n' > "$t"
    printf 'network={\n\tssid="First"\n\tpsk=aaaa\n}\n' >> "$t"
    printf 'network = {\n\tssid="Second"\n\tkey_mgmt=NONE\n}\n' >> "$t"

    st_eq "найдено сетей (форматы 'network={' и 'network = {')" "$(count_saved_nets)" 2
    have_saved_nets && st_ok "have_saved_nets видит сети" || st_bad "have_saved_nets не видит сети"
    st_eq "строк в списке сетей" "$(list_saved_nets | grep -c .)" 2
    list_saved_nets | grep -q 'First' && st_ok "в списке есть First" || st_bad "в списке нет First"

    net_block_del "First"
    st_eq "сетей после удаления First" "$(count_saved_nets)" 1
    grep -q 'ssid="First"' "$t" && st_bad "блок First не удалён" || st_ok "блок First удалён"
    grep -q 'ssid="Second"' "$t" && st_ok "соседний блок Second не пострадал" || st_bad "net_block_del задел соседний блок"
    grep -q '^update_config=1' "$t" && st_ok "строки вне блоков сохранены" || st_bad "повреждено содержимое вне блоков"

    net_block_del "Second"
    st_eq "сетей после удаления Second (формат 'network = {')" "$(count_saved_nets)" 0

    printf 'network={\n\tssid="Dup"\n\tpsk=old\n}\n' >> "$t"
    net_block_del "Dup"
    printf 'network={\n\tssid="Dup"\n\tpsk=new\n}\n' >> "$t"
    st_eq "блоков сети Dup после повторного connect" "$(grep -c 'ssid="Dup"' "$t")" 1
    grep -q 'psk=new' "$t" && st_ok "новый пароль на месте" || st_bad "новый пароль потерялся"

    printf 'network={\n\tssid="Broken"\n' > "$t"
    net_block_del "NoSuchNet"
    grep -q 'ssid="Broken"' "$t" && st_ok "незакрытый блок не потерян" || st_bad "незакрытый блок проглочен"

    rm -f "$t"
    CONF="$CONF_SAVE"

    st_eq "режим AP для канала 6 (2.4 ГГц)" "$(ap_hw_mode_for_chan 6)" "g"
    st_eq "режим AP для канала 36 (5 ГГц)"  "$(ap_hw_mode_for_chan 36)" "a"
    st_eq "режим AP для канала 149 (5 ГГц)" "$(ap_hw_mode_for_chan 149)" "a"

    if [ "$bad" -eq 0 ]; then ok "selftest: пройдено проверок $n, провалов 0"
    else warn "selftest: провалено $bad из $n"; fi
    return "$rc"
}

# ---------------------------------------------------------------- wifi ap
ap_hw_mode_for_chan() {
    local ch="${1:-6}"
    case "$ch" in ''|*[!0-9]*) echo "g"; return 0 ;; esac
    if [ "$ch" -ge 36 ]; then echo "a"; else echo "g"; fi
}

phy_of() {
    if [ -f "/sys/class/net/$1/phy80211/name" ]; then
        cat "/sys/class/net/$1/phy80211/name" 2>/dev/null
    else
        iw dev "$1" info 2>/dev/null | awk '/wiphy/{print "phy"$2; exit}'
    fi
}

cmd_ap() {
    need_root
    case "${1:-}" in
        off) shift; cmd_ap_off "$@"; return 0 ;;
        "")  say "использование: wifi ap <SSID> [пароль] [канал 1..13|36..165] [iface]"; say "остановить: wifi ap off [iface]"; return 0 ;;
    esac
    local ssid="$1" pass="${2:-}" ch="${3:-6}" req_ifc="${4:-}"
    local ifc hw_mode phy phy_info hconf
    ifc=$(require_wl "$req_ifc") || return 1
    command -v hostapd >/dev/null 2>&1 || die "нет hostapd"
    load_stack; apply_reg
    stop_ap_ifc "$ifc"
    stop_wpa "$ifc"; dhcp_stop "$ifc"
    ip addr flush dev "$ifc" 2>/dev/null || true
    hw_mode=$(ap_hw_mode_for_chan "$ch")
    phy=$(phy_of "$ifc")
    phy_info=""
    [ -n "$phy" ] && phy_info=$(iw phy "$phy" info 2>/dev/null || true)
    hconf="/etc/hostapd/informer-ap-${ifc}.conf"
    mkdir -p "$(dirname "$hconf")" "$RUN"
    {
        echo "interface=$ifc"
        echo "driver=nl80211"
        echo "ssid=$ssid"
        echo "hw_mode=$hw_mode"
        echo "channel=$ch"
        echo "country_code=$(cat "$REG_FILE" 2>/dev/null || echo RU)"
        echo "ieee80211d=1"
        echo "wmm_enabled=1"
        if printf '%s\n' "$phy_info" | grep -q 'HT20'; then
            echo "ieee80211n=1"
        fi
        if [ "$hw_mode" = "a" ] && printf '%s\n' "$phy_info" | grep -q 'VHT Capabilities'; then
            echo "ieee80211ac=1"
        fi
        if [ -n "$pass" ]; then
            echo "wpa=2"
            echo "wpa_passphrase=$pass"
            echo "wpa_key_mgmt=WPA-PSK"
            echo "rsn_pairwise=CCMP"
        fi
        echo "ignore_broadcast_ssid=0"
    } > "$hconf"
    chmod 600 "$hconf"
    ln -sfn "$hconf" "$HOSTAPD_CONF" 2>/dev/null || true
    ip addr add "$AP_IP/24" dev "$ifc" 2>/dev/null || true
    ip link set "$ifc" up 2>/dev/null || true
    hostapd -B -P "$RUN/hostapd.$ifc.pid" "$hconf" >/dev/null 2>&1 \
        || die "hostapd не стартовал на $ifc (канал $ch, hw_mode=$hw_mode; проверьте 'iw list' / 'wifi reg')"
    ln -sfn "$RUN/hostapd.$ifc.pid" "$RUN/hostapd.pid" 2>/dev/null || true
    if command -v dnsmasq >/dev/null 2>&1; then
        [ -f "$RUN/dnsmasq-ap.$ifc.pid" ] && kill "$(cat "$RUN/dnsmasq-ap.$ifc.pid")" 2>/dev/null || true
        dnsmasq --interface="$ifc" --except-interface=lo --bind-dynamic \
            --dhcp-range="$AP_NET.50,$AP_NET.150,255.255.255.0,12h" \
            --dhcp-option=3,"$AP_IP" --dhcp-option=6,"$AP_IP" --port=53 \
            --dhcp-leasefile="$RUN/dnsmasq-ap.$ifc.leases" \
            --pid-file="$RUN/dnsmasq-ap.$ifc.pid" >/dev/null 2>&1 \
            && ok "DHCP+DNS на $ifc: адреса $AP_NET.50-$AP_NET.150"
    fi
    local band_str="2.4 ГГц"
    [ "$hw_mode" = "a" ] && band_str="5 ГГц"
    ok "точка доступа '$ssid' на $ifc ($band_str, канал $ch), адрес платы $AP_IP/24"
    sync_ap_nat_ifc "$ifc"
}

cmd_ap_off() {
    need_root
    local target="${1:-}"
    if [ -n "$target" ]; then
        stop_ap_ifc "$target"
        ip addr flush dev "$target" 2>/dev/null || true
        ip link set "$target" down 2>/dev/null || true
        iw dev "$target" set type managed 2>/dev/null || true
        ok "точка доступа на $target остановлена"
        return 0
    fi
    for ifc in $(wl_list); do
        if ap_running "$ifc" || [ -f "$RUN/hostapd.$ifc.pid" ]; then
            stop_ap_ifc "$ifc"
            ip addr flush dev "$ifc" 2>/dev/null || true
            ip link set "$ifc" down 2>/dev/null || true
            iw dev "$ifc" set type managed 2>/dev/null || true
        fi
    done
    [ -f "$RUN/hostapd.pid" ] && kill "$(cat "$RUN/hostapd.pid" 2>/dev/null)" 2>/dev/null || true
    [ -f "$RUN/dnsmasq-ap.pid" ] && kill "$(cat "$RUN/dnsmasq-ap.pid" 2>/dev/null)" 2>/dev/null || true
    rm -f "$RUN/hostapd.pid" "$RUN/dnsmasq-ap.pid" "$RUN/dnsmasq-ap.leases"
    ok "точка доступа остановлена"
}

# ---------------------------------------------------------------- wifi share
cmd_share() {
    need_root
    local wl gwif
    wl=$(wl_list | head -1)
    gwif=$(ip route 2>/dev/null | awk '/^default/{print $5; exit}')
    case "${1:-on}" in
        off)
            if command -v iptables >/dev/null 2>&1 && [ -n "$wl" ]; then
                iptables -t nat -D POSTROUTING -o "$wl" -j MASQUERADE 2>/dev/null || true
                iptables -D FORWARD -i usb0 -o "$wl" -j ACCEPT 2>/dev/null || true
                iptables -D FORWARD -i "$wl" -o usb0 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
            fi
            echo 0 > /proc/sys/net/ipv4/ip_forward 2>/dev/null || true
            [ -f "$RUN/dnsmasq-share.pid" ] && kill "$(cat "$RUN/dnsmasq-share.pid")" 2>/dev/null || true
            rm -f "$RUN/dnsmasq-share.pid"
            # Возвращаем штатный DHCP без шлюза на usb0
            if [ -e /sys/class/net/usb0 ] && command -v dnsmasq >/dev/null 2>&1; then
                dnsmasq --port=0 --interface=usb0 --except-interface=lo --bind-dynamic \
                    --dhcp-range=192.168.77.20,192.168.77.60,255.255.255.0,24h \
                    --dhcp-option=3 --dhcp-option=6 \
                    --dhcp-leasefile=/run/dnsmasq-usb-usb0.leases \
                    --pid-file=/run/dnsmasq-usb-usb0.pid 2>/dev/null || true
            fi
            ok "раздача интернета на ПК выключена"
            return 0 ;;
        on|"") ;;
        *) say "использование: wifi share [on|off]"; return 1 ;;
    esac
    [ -n "$wl" ] || die "нет WiFi-интерфейса (wifi connect <SSID> <пароль>)"
    [ "$gwif" = "$wl" ] || warn "маршрут по умолчанию идёт не через $wl (${gwif:-нет})"
    [ -e /sys/class/net/usb0 ] || warn "нет usb0 - сначала 'usbnet on'"
    command -v iptables >/dev/null 2>&1 || die "нет iptables"
    mkdir -p "$RUN"
    if command -v dnsmasq >/dev/null 2>&1 && [ -e /sys/class/net/usb0 ]; then
        [ -f /run/dnsmasq-usb-usb0.pid ] && kill "$(cat /run/dnsmasq-usb-usb0.pid)" 2>/dev/null || true
        [ -f "$RUN/dnsmasq-share.pid" ] && kill "$(cat "$RUN/dnsmasq-share.pid")" 2>/dev/null || true
        dnsmasq --interface=usb0 --except-interface=lo --bind-dynamic --port=53 \
            --dhcp-range=192.168.77.20,192.168.77.60,255.255.255.0,24h \
            --dhcp-option=3,192.168.77.1 --dhcp-option=6,192.168.77.1 \
            --dhcp-leasefile=/run/dnsmasq-usb-usb0.leases \
            --pid-file="$RUN/dnsmasq-share.pid" >/dev/null 2>&1 \
            && ok "DHCP+DNS на usb0 раздаёт шлюз и DNS 192.168.77.1"
    fi
    echo 1 > /proc/sys/net/ipv4/ip_forward
    iptables -t nat -C POSTROUTING -o "$wl" -j MASQUERADE 2>/dev/null \
        || iptables -t nat -A POSTROUTING -o "$wl" -j MASQUERADE
    iptables -C FORWARD -i usb0 -o "$wl" -j ACCEPT 2>/dev/null \
        || iptables -A FORWARD -i usb0 -o "$wl" -j ACCEPT
    iptables -C FORWARD -i "$wl" -o usb0 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
        || iptables -A FORWARD -i "$wl" -o usb0 -m state --state RELATED,ESTABLISHED -j ACCEPT
    ok "интернет с $wl раздаётся на ПК через usb0 (NAT включён)"
}

usage() {
    cat <<EOF
wifi - USB-WiFi адаптер на Informer 701 (разъём на месте WiFi-модуля = USB2)

  wifi dev                 что воткнуто, какой драйвер, каких прошивок не хватает
  wifi scan [iface]        список сетей вокруг (сигнал, канал, тип защиты)
  wifi connect SSID [пароль] [iface]
                           подключиться и ЗАПОМНИТЬ сеть в
                           /etc/wpa_supplicant/wpa_supplicant.conf
  wifi up                  подключиться к запомненной сети
  wifi selftest            проверка логики конфига без железа (регекспы grep/awk)
  wifi dhcp [iface]        заново запросить адрес по DHCP (dhclient)
  wifi static IP/маска [шлюз] [DNS]
                           статический адрес (/etc/wifi-static); wifi static off
  wifi down                остановить wpa_supplicant/dhclient, снять адрес
  wifi status              интерфейс, сеть, сигнал, адрес, шлюз, DNS
  wifi log [N]             последние N строк /var/log/wifi.log
  wifi fw                  какие прошивки есть и что просило ядро
  wifi tx [1..30|max] [iface] мощность передатчика в дБм (/etc/wifi-txpower)
  wifi ps on|off|status    power save драйвера
  wifi reg [RU|US|...]     регуляторный домен страны
  wifi auto on|off|status  автоподключение при загрузке (systemd)
  wifi config              конфигуратор ролей нескольких адаптеров (STA + AP,
                           сохранение между перезагрузками; то же: wifi-config)
  wifi apply               применить сохранённые профили wifi-config прямо сейчас
  wifi ap SSID [пароль] [канал] [iface]
                           точка доступа 2.4/5 ГГц (hostapd + dnsmasq 192.168.71.x)
  wifi ap off [iface]      остановить точку доступа
  wifi share [on|off]      раздать интернет с WiFi на ПК по micro-USB (NAT)
EOF
}

cmd="${1:-help}"
shift 2>/dev/null || true
mkdir -p "$RUN" 2>/dev/null || true
case "$cmd" in
    config|cfg)    exec /usr/local/bin/wifi-config "$@" ;;
    apply)         cmd_apply ;;
    dev|devices)   cmd_dev ;;
    scan|sc)       cmd_scan "$@" ;;
    connect|con)   cmd_connect "$@" ;;
    up|start)      cmd_up ;;
    daemon)        cmd_daemon ;;
    down|stop)     cmd_down ;;
    dhcp|ip)       cmd_dhcp "$@" ;;
    tx|power)      cmd_tx "$@" ;;
    ps)            cmd_ps "$@" ;;
    static|stat)   cmd_static "$@" ;;
    status|st)     cmd_status ;;
    log)           cmd_log "$@" ;;
    fw|firmware)   cmd_fw ;;
    reg|country)   cmd_reg "$@" ;;
    auto)          cmd_auto "$@" ;;
    selftest|test) cmd_selftest ;;
    ap)            cmd_ap "$@" ;;
    share|nat)     cmd_share "$@" ;;
    help|-h|--help|"") usage ;;
    *)             usage; exit 1 ;;
esac
