# ---------------------------------------------------------------- wifi reg
cmd_reg() {
    need_root; load_stack
    cc=$(echo "$1" | tr 'a-z' 'A-Z' | tr -dc 'A-Z')
    if [ -z "$cc" ]; then
        say "текущая страна: $(iw reg get 2>/dev/null | head -1)"
        say "сохранено в $REG_FILE: $(cat "$REG_FILE" 2>/dev/null || echo '-')"
        say "установить: wifi reg RU   (для России; влияет на доступные каналы и мощность)"
        return 0
    fi
    [ ${#cc} -eq 2 ] || die "код страны - две буквы (RU, US, DE, ...)"
    if iw reg set "$cc" 2>/dev/null; then
        echo "$cc" > "$REG_FILE"
        sleep 1
        cur=$(iw reg get 2>/dev/null | head -1)
        case "$cur" in
            *"country $cc"*)
                ok "страна $cc применена и сохранена ($REG_FILE)"
                iw reg get 2>/dev/null | head -4 | sed 's/^/  /' ;;
            *)
                warn "iw reg set принял $cc, но домен не сменился: $cur"
                say "    причина: ядро отвергло подпись /lib/firmware/regulatory.db."
                say "    проверка:  dmesg | grep -i regdb   (строка 'malformed or signature'"
                say "    missing/invalid' = база подписана ключом, которого нет в ядре)."
                say "    в b022+ лежит regdb 2023.09.01, подписанный sforshee - см."
                say "    docs/regulatory-db.md. Каналы 12-13 при этом недоступны." ;;
        esac
    else
        warn "iw reg set $cc не сработал (нет regulatory.db? нет cfg80211?)"
    fi
}

cmd_auto() {
    need_root
    case "${1:-status}" in
        on)  touch "$AUTO_FLAG"; ok "автоподключение при загрузке ВКЛЮЧЕНО ($AUTO_FLAG)"
             ensure_conf
             have_saved_nets || warn "в $CONF нет сохранённых сетей - сначала wifi connect" ;;
        off) rm -f "$AUTO_FLAG"; ok "автоподключение выключено" ;;
        *)   say "автоподключение: $([ -f "$AUTO_FLAG" ] && echo ВКЛЮЧЕНО || echo выключено)"
             say "сохранённые сети:"
             list_saved_nets ;;
    esac
}

# ------------------------------------------------------------- wifi selftest
# Проверка ТЕКСТОВОЙ логики конфига wpa_supplicant - без железа и без сети.
# Появилась после того, как шаблоны grep/awk молча перестали совпадать с
# настоящим конфигом от wpa_passphrase ("network={"): автоподключение при
# загрузке не видело сохранённую сеть, 'wifi auto on' печатал ложное
# предупреждение, 'wifi status' показывал 0 сетей, а повторный 'wifi connect'
# плодил дубликаты блоков. Шаблоны сверены на GNU grep 3.8 и на busybox
# grep/awk 1.36.1 (Alpine) - both дают одинаковый результат.
cmd_selftest() {
    rc=0; n=0; bad=0
    t="${TMPDIR:-/tmp}/wifi-selftest.$$"
    CONF_SAVE=$CONF; CONF=$t
    st_ok()  { n=$((n+1)); say "  OK   $1"; }
    st_bad() { n=$((n+1)); bad=$((bad+1)); say "  FAIL $1"; rc=1; }
    st_eq()  { if [ "$2" = "$3" ]; then st_ok "$1 = $2"; else st_bad "$1: получено '$2', ожидалось '$3'"; fi; }

    say "wifi selftest: логика конфига (временный файл $t)"
    # конфиг ровно в том виде, в каком его оставляет wpa_passphrase + рукописный блок
    printf 'ctrl_interface=/var/run/wpa_supplicant\nupdate_config=1\n' > "$t"
    printf 'network={\n\tssid="First"\n\tpsk=aaaa\n}\n' >> "$t"
    printf 'network = {\n\tssid="Second"\n\tkey_mgmt=NONE\n}\n' >> "$t"

    st_eq "найдено сетей (форматы 'network={' и 'network = {')" "$(count_saved_nets)" 2
    have_saved_nets && st_ok "have_saved_nets видит сети" || st_bad "have_saved_nets не видит сети"
    st_eq "строк в списке сетей" "$(list_saved_nets | grep -c .)" 2
    list_saved_nets | grep -q 'First' && st_ok "в списке есть First" || st_bad "в списке нет First"

    net_block_del "First"
    st_eq "сетей после удаления First" "$(count_saved_nets)" 1
    grep -q 'ssid="First"' "$t" && st_bad "блок First не удалён" || st_ok "блок First удалён"
    grep -q 'ssid="Second"' "$t" && st_ok "соседний блок Second не пострадал" || st_bad "net_block_del задел соседний блок"
    grep -q '^update_config=1' "$t" && st_ok "строки вне блоков сохранены" || st_bad "повреждено содержимое вне блоков"

    net_block_del "Second"
    st_eq "сетей после удаления Second (формат 'network = {')" "$(count_saved_nets)" 0

    # повторное подключение к той же сети не должно плодить дубликаты
    printf 'network={\n\tssid="Dup"\n\tpsk=old\n}\n' >> "$t"
    net_block_del "Dup"
    printf 'network={\n\tssid="Dup"\n\tpsk=new\n}\n' >> "$t"
    st_eq "блоков сети Dup после повторного connect" "$(grep -c 'ssid="Dup"' "$t")" 1
    grep -q 'psk=new' "$t" && st_ok "новый пароль на месте" || st_bad "новый пароль потерялся"

    # незакрытый блок не должен проглатывать остаток файла
    printf 'network={\n\tssid="Broken"\n' > "$t"
    net_block_del "NoSuchNet"
    grep -q 'ssid="Broken"' "$t" && st_ok "незакрытый блок не потерян" || st_bad "незакрытый блок проглочен"

    rm -f "$t"; CONF=$CONF_SAVE
    if [ "$bad" -eq 0 ]; then ok "selftest: пройдено проверок $n, провалов 0"
    else warn "selftest: провалено $bad из $n"; fi
    return $rc
}

# ---------------------------------------------------------------- wifi ap
cmd_ap() {
    need_root
    case "${1:-}" in
        off) cmd_ap_off; return 0 ;;
        "")  say "использование: wifi ap <SSID> [пароль] [канал]   (пароль >= 8 символов, без пароля - открытая сеть)"
             say "остановить: wifi ap off"; return 0 ;;
    esac
    ssid=$1; pass=$2; ch=${3:-6}
    ifc=$(require_wl "") || return 1
    command -v hostapd >/dev/null 2>&1 || die "нет hostapd (pkg add hostapd)"
    load_stack; apply_reg
    stop_wpa "$ifc"; killall udhcpc 2>/dev/null
    ip addr flush dev "$ifc" 2>/dev/null
    {
        echo "interface=$ifc"
        echo "driver=nl80211"
        echo "ssid=$ssid"
        echo "hw_mode=g"
        echo "channel=$ch"
        echo "country_code=$(cat "$REG_FILE" 2>/dev/null || echo RU)"
        echo "ieee80211d=1"
        echo "wmm_enabled=1"
        if [ -n "$pass" ]; then
            echo "wpa=2"
            echo "wpa_passphrase=$pass"
            echo "wpa_key_mgmt=WPA-PSK"
            echo "rsn_pairwise=CCMP"
        else
            echo "# открытая сеть (пароль не задан)"
        fi
        echo "ignore_broadcast_ssid=0"
    } > "$HOSTAPD_CONF"
    chmod 600 "$HOSTAPD_CONF"
    ip addr add "$AP_IP/24" dev "$ifc" 2>/dev/null
    ip link set "$ifc" up 2>/dev/null
    hostapd -B -P "$RUN/hostapd.pid" "$HOSTAPD_CONF" >/dev/null 2>&1 \
        || die "hostapd не стартовал (iw list: поддерживает ли адаптер режим AP?)"
    if command -v dnsmasq >/dev/null 2>&1; then
        killall dnsmasq 2>/dev/null
        dnsmasq --interface="$ifc" --bind-interfaces --dhcp-range="$AP_NET.50,$AP_NET.150,12h" \
            --dhcp-option=3,"$AP_IP" --dhcp-option=6,"$AP_IP" --port=53 \
            --pid-file="$RUN/dnsmasq-ap.pid" >/dev/null 2>&1 \
            && ok "DHCP+DNS на $ifc: адреса $AP_NET.50-$AP_NET.150"
    else
        warn "нет dnsmasq - клиенты получат адрес только при статике"
    fi
    ok "точка доступа '$ssid' на $ifc, канал $ch, адрес платы $AP_IP/24"
    # если у платы самой есть интернет (например, usbnet nat) - раздаём его клиентам
    gw=$(ip route 2>/dev/null | awk '/^default/ && $5 != "'"$ifc"'" {print $5; exit}')
    if [ -n "$gw" ] && command -v iptables >/dev/null 2>&1; then
        echo 1 > /proc/sys/net/ipv4/ip_forward
        iptables -t nat -C POSTROUTING -o "$gw" -j MASQUERADE 2>/dev/null \
            || iptables -t nat -A POSTROUTING -o "$gw" -j MASQUERADE
        iptables -C FORWARD -i "$ifc" -o "$gw" -j ACCEPT 2>/dev/null \
            || iptables -A FORWARD -i "$ifc" -o "$gw" -j ACCEPT
        iptables -C FORWARD -i "$gw" -o "$ifc" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
            || iptables -A FORWARD -i "$gw" -o "$ifc" -m state --state RELATED,ESTABLISHED -j ACCEPT
        ok "клиентам точки доступа раздаётся интернет через $gw (NAT)"
    else
        say "  интернета у платы нет - точка доступа работает как локальная сеть"
        say "  (дать плате интернет: usbnet nat  или  wifi connect ...)"
    fi
}

cmd_ap_off() {
    need_root
    [ -f "$RUN/hostapd.pid" ] && kill "$(cat "$RUN/hostapd.pid")" 2>/dev/null
    killall hostapd dnsmasq 2>/dev/null
    rm -f "$RUN/hostapd.pid" "$RUN/dnsmasq-ap.pid"
    for ifc in $(wl_list); do ip addr flush dev "$ifc" 2>/dev/null; done
    echo 0 > /proc/sys/net/ipv4/ip_forward 2>/dev/null
    ok "точка доступа остановлена"
}

# ---------------------------------------------------------------- wifi share
# Раздать интернет с WiFi-адаптера на ПК по USB-кабелю (usb0 = RNDIS-гаджет).
cmd_share() {
    need_root
    wl=$(wl_list | head -1)
    gwif=$(ip route 2>/dev/null | awk '/^default/{print $5; exit}')
    case "${1:-on}" in
      off)
        command -v iptables >/dev/null 2>&1 && {
            iptables -t nat -D POSTROUTING -o "$wl" -j MASQUERADE 2>/dev/null
            iptables -D FORWARD -i usb0 -o "$wl" -j ACCEPT 2>/dev/null
            iptables -D FORWARD -i "$wl" -o usb0 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null
        }
        echo 0 > /proc/sys/net/ipv4/ip_forward 2>/dev/null
        [ -f "$RUN/dnsmasq-share.pid" ] && kill "$(cat "$RUN/dnsmasq-share.pid")" 2>/dev/null
        killall dnsmasq 2>/dev/null
        # вернуть udhcpd без router/dns (как делает usbnet)
        if [ -f /etc/udhcpd-usb0.conf ] && [ -f /etc/udhcpd-usb0.conf.bak ]; then
            cp /etc/udhcpd-usb0.conf.bak /etc/udhcpd-usb0.conf
            killall udhcpd 2>/dev/null; udhcpd /etc/udhcpd-usb0.conf 2>/dev/null
        fi
        ok "раздача интернета на ПК выключена (usbnet nat off / usbnet on - вернуть обычную схему)"
        return 0 ;;
      on|"") ;;
      *) say "использование: wifi share [on|off]"; return 1 ;;
    esac
    [ -n "$wl" ] || die "нет WiFi-интерфейса (wifi connect <SSID> <пароль>)"
    [ "$gwif" = "$wl" ] || warn "маршрут по умолчанию идёт не через $wl (${gwif:-нет}) - интернет может не раздаваться"
    [ -e /sys/class/net/usb0 ] || warn "нет usb0 - сначала 'usbnet on'"
    command -v iptables >/dev/null 2>&1 || die "нет iptables (pkg add iptables-legacy)"
    mkdir -p "$RUN"
    # udhcpd для ПК: добавляем router и dns (обычно usbnet их намеренно не отдаёт)
    if [ -f /etc/udhcpd-usb0.conf ]; then
        cp /etc/udhcpd-usb0.conf /etc/udhcpd-usb0.conf.bak
        grep -q '^option\trouter' /etc/udhcpd-usb0.conf || {
            printf 'option\trouter\t192.168.77.1\noption\tdns\t192.168.77.1\n' >> /etc/udhcpd-usb0.conf
        }
        killall udhcpd 2>/dev/null; sleep 1
        udhcpd /etc/udhcpd-usb0.conf 2>/dev/null && ok "udhcpd на usb0 раздаёт адрес, шлюз и DNS (192.168.77.1)"
    fi
    # DNS-форвардер для ПК
    if command -v dnsmasq >/dev/null 2>&1; then
        killall dnsmasq 2>/dev/null
        dnsmasq --listen-address=192.168.77.1 --bind-interfaces --port=53 \
            --pid-file="$RUN/dnsmasq-share.pid" >/dev/null 2>&1 && ok "DNS-форвардер на 192.168.77.1"
    fi
    echo 1 > /proc/sys/net/ipv4/ip_forward
    iptables -t nat -C POSTROUTING -o "$wl" -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -o "$wl" -j MASQUERADE
    iptables -C FORWARD -i usb0 -o "$wl" -j ACCEPT 2>/dev/null || iptables -A FORWARD -i usb0 -o "$wl" -j ACCEPT
    iptables -C FORWARD -i "$wl" -o usb0 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
        || iptables -A FORWARD -i "$wl" -o usb0 -m state --state RELATED,ESTABLISHED -j ACCEPT
    ok "интернет с $wl раздаётся на ПК через usb0 (NAT включён)"
    say "  на ПК адаптер RNDIS должен получить адрес 192.168.77.x, шлюз и DNS 192.168.77.1."
    say "  если адрес уже был - отключите и подключите адаптер заново (или 'ipconfig /renew')."
    say "  выключить: wifi share off"
}

# ---------------------------------------------------------------- usage
usage() {
    cat <<EOF
wifi - USB-WiFi адаптер на Informer 701 (разъём на месте WiFi-модуля = USB2)

  wifi dev                 что воткнуто, какой драйвер, каких прошивок не хватает
  wifi scan [iface]        список сетей вокруг (сигнал, канал, тип защиты)
  wifi connect SSID [пароль] [iface]
                           подключиться и ЗАПОМНИТЬ сеть в
                           /etc/wpa_supplicant/wpa_supplicant.conf
  wifi up                  подключиться к запомненной сети (это же делает
                           загрузка при wifi auto on)
  wifi selftest            проверка логики конфига без железа (регекспы grep/awk)
  wifi dhcp [iface]        заново запросить адрес по DHCP (без переподключения)
  wifi static IP/маска [шлюз] [DNS]
                           статический адрес (сохраняется в /etc/wifi-static);
                           wifi static off - снять и вернуться к DHCP
  wifi down                остановить wpa_supplicant/udhcpc, снять адрес
  wifi status              интерфейс, сеть, сигнал, адрес, шлюз, DNS
  wifi log [N]             последние N строк /var/log/wifi.log
  wifi fw                  какие прошивки есть и что просило ядро
  wifi tx [1..20|max]      мощность передатчика в дБм (сохраняется в
                           /etc/wifi-txpower). wifi tx 5 - если плата виснет
                           при подключении: передатчик даёт импульсы тока,
                           а питание от USB ПК слабое. Замер: pmic-vbus watch
  wifi ps on|off|status    power save драйвера (off - стабильнее на слабом питании)
  wifi reg [RU|US|...]     страна (каналы/мощность); без аргумента - показать
  wifi auto on|off|status  подключаться к запомненной сети при каждой загрузке
  wifi ap SSID [пароль] [канал]
                           плата = точка доступа (hostapd + DHCP 192.168.71.x);
                           если у платы есть интернет - раздаст его клиентам
  wifi ap off              остановить точку доступа
  wifi share [on|off]      раздать интернет с WiFi на ПК по USB-кабелю (NAT)

Интернет для пакетов: wifi connect ... (или usbnet nat - через ПК по кабелю).
Типовая последовательность: wifi dev -> wifi scan -> wifi connect -> pkg update.
EOF
}

# ---------------------------------------------------------------- main
cmd=${1:-help}
shift 2>/dev/null
mkdir -p "$RUN" 2>/dev/null
case "$cmd" in
    dev|devices)   cmd_dev ;;
    scan|sc)       cmd_scan "$@" ;;
    connect|con)   cmd_connect "$@" ;;
    up|start)      cmd_up ;;
    down|stop)     cmd_down ;;
    dhcp|ip)       cmd_dhcp "$@" ;;
    tx|power)      cmd_tx "$@" ;;
    ps)            cmd_ps "$@" ;;
    static|stat)   cmd_static "$@" ;;
    status|st)     cmd_status ;;
    log)           cmd_log "$@" ;;
    fw|firmware)   cmd_fw ;;
    reg|country)   cmd_reg "$@" ;;
    auto)          cmd_auto "$@" ;;
    selftest|test) cmd_selftest ;;
    ap)            cmd_ap "$@" ;;
    share|nat)     cmd_share "$@" ;;
    help|-h|--help|"") usage ;;
    *)             usage; exit 1 ;;
esac
