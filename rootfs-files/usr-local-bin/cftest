#!/bin/bash
# cftest [секунды] - прогон по всем частотам cpufreq с контролем VDD-CPU на AXP209
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

DUR="${1:-5}"
CF=/sys/devices/system/cpu/cpu0/cpufreq
if [ ! -d "$CF" ]; then
    echo "cpufreq недоступен ($CF нет). Возможные причины:"
    echo "  - загружен вариант DTB без таблицы OPP (например nopmic)"
    echo "  - регулятор vdd-cpu (dcdc2 на AXP209) не зарегистрировался -> смотрите 'diag'"
    exit 1
fi

BUS=$(i2cbus)
OLD_GOV=$(cat "$CF/scaling_governor")
if ! grep -qw userspace "$CF/scaling_available_governors"; then
    echo "ВНИМАНИЕ: governor 'userspace' недоступен (есть: $(cat "$CF/scaling_available_governors"))."
    echo "Переключаю scaling_min_freq = scaling_max_freq для фиксации частоты."
    MODE=minmax
else
    echo userspace > "$CF/scaling_governor"
    MODE=userspace
fi
OLD_MIN=$(cat "$CF/scaling_min_freq")
OLD_MAX=$(cat "$CF/scaling_max_freq")
trap 'echo "$OLD_MIN" > "$CF/scaling_min_freq" 2>/dev/null; echo "$OLD_MAX" > "$CF/scaling_max_freq" 2>/dev/null; echo "$OLD_GOV" > "$CF/scaling_governor" 2>/dev/null' EXIT INT TERM

FREQS=$(cat "$CF/scaling_available_frequencies")
echo "Доступные точки: $FREQS (кГц). По ${DUR} с под нагрузкой на каждую."
printf '%-10s %-10s %-12s %-12s %s\n' "цель кГц" "факт кГц" "PLL1 МГц" "DCDC2 мВ" "результат"

for f in $FREQS; do
    if [ "$MODE" = userspace ]; then
        echo "$f" > "$CF/scaling_setspeed"
    else
        echo "$f" > "$CF/scaling_max_freq" 2>/dev/null || true
        echo "$f" > "$CF/scaling_min_freq" 2>/dev/null || true
        echo "$f" > "$CF/scaling_max_freq" 2>/dev/null || true
    fi
    sleep 1
    ( dd if=/dev/zero bs=65536 count=2000 2>/dev/null | md5sum >/dev/null ) &
    LOAD=$!
    sleep "$DUR"
    kill "$LOAD" 2>/dev/null; wait "$LOAD" 2>/dev/null || true
    cur=$(cat "$CF/scaling_cur_freq")
    d2=$(i2cget -f -y "$BUS" 0x34 0x23 2>/dev/null || true)
    mv="?"
    [ -n "$d2" ] && mv=$(( 700 + 25 * (d2 & 0x3f) ))
    p1=$(devmem2 0x01c20000 w 2>/dev/null | awk '/Read at address/{print $NF}')
    if [ -n "$p1" ]; then
        v=$((p1))
        n=$(( (v >> 8) & 0x1f )); k=$(( ((v >> 4) & 3) + 1 )); p=$(( 1 << ((v >> 16) & 3) ))
        [ "$n" -eq 0 ] && n=1
        pll=$(( 24 * n * k / p ))
    else pll="?"; fi
    printf '%-10s %-10s %-12s %-12s %s\n' "$f" "$cur" "$pll" "$mv" "OK"
done
echo "Все точки пройдены без зависания."
