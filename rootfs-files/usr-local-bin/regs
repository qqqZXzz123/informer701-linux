#!/bin/bash
# regs - сырой дамп ключевых регистров Allwinner A10 (CCU, PIO, UART0, TWI0, MMC0, DRAM, WDT)
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

rd() {
    local v
    v=$(devmem2 "$1" w 2>/dev/null | awk '/Read at address/ {print $NF}')
    printf '  %-12s %-28s = %s\n' "$1" "$2" "${v:-ERR}"
}

echo "=== CCU (0x01c20000) ==="
rd 0x01c20000 "PLL1_CFG (CPU)"
rd 0x01c20004 "PLL1_TUN"
rd 0x01c20020 "PLL5_CFG (DDR)"
rd 0x01c20028 "PLL6_CFG (PERIPH)"
rd 0x01c20054 "CPU_AHB_APB0_CFG"
rd 0x01c20058 "APB1_CLK_DIV"
rd 0x01c20060 "AHB_GATING0"
rd 0x01c20064 "AHB_GATING1"
rd 0x01c20068 "APB0_GATING"
rd 0x01c2006c "APB1_GATING (UART/TWI)"
rd 0x01c20088 "MMC0_CLK"
rd 0x01c20090 "MMC2_CLK"

echo "=== PIO PB (0x01c20824) - PB0/1=I2C0, PB22/23=UART0 ==="
rd 0x01c20824 "PB_CFG0 (PB0..PB7)"
rd 0x01c2082c "PB_CFG2 (PB16..PB23)"
rd 0x01c20834 "PB_DATA"
rd 0x01c20840 "PB_PULL0"
rd 0x01c20844 "PB_PULL1"

echo "=== TWI0 / I2C0 (0x01c2ac00) ==="
rd 0x01c2ac0c "TWI0_CNTR"
rd 0x01c2ac10 "TWI0_STAT"
rd 0x01c2ac14 "TWI0_CCR (clock)"
rd 0x01c2ac1c "TWI0_EFR"
rd 0x01c2ac20 "TWI0_LCR (line state)"

echo "=== TIMER / WATCHDOG (0x01c20c00) ==="
rd 0x01c20c90 "WDOG_CTRL"
rd 0x01c20c94 "WDOG_MODE"

echo "=== SID / CHIP VERSION ==="
rd 0x01c23800 "SID_KEY0"
rd 0x01c23804 "SID_KEY1"
rd 0x01c00024 "SRAM_VER_REG"
