#!/bin/bash
# savelog - сохранить вывод diag + journalctl на раздел BOOT (vFAT, читается на любом ПК)
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

MP=/boot
mkdir -p "$MP"
if ! mountpoint -q "$MP" 2>/dev/null; then
    if ! mount -t vfat /dev/mmcblk0p1 "$MP" 2>/dev/null; then
        echo "ОШИБКА: не удалось смонтировать /dev/mmcblk0p1 в $MP" >&2
        echo "Разделы в системе:" >&2
        cat /proc/partitions >&2
        exit 1
    fi
fi

mkdir -p "$MP/logs"
TS=$(date +%Y%m%d-%H%M%S 2>/dev/null || echo boot)
OUT="$MP/logs/diag-$TS.txt"
echo "Собираю диагностику в $OUT ..."
{
    diag
    if command -v journalctl >/dev/null 2>&1; then
        printf '\n===== JOURNALCTL (ПОСЛЕДНИЕ 200 СТРОК) =====\n'
        journalctl -b --no-pager -n 200 2>/dev/null || true
    fi
} > "$OUT" 2>&1
sync
ls -lh "$OUT"
echo "Готово. При необходимости выключите плату, вставьте SD в ПК -> папка logs/ на первом разделе."
