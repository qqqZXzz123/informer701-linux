#!/bin/bash
# /sbin/hotplug - ранний помощник uevent для ядра (CONFIG_UEVENT_HELPER_PATH).
# В полной системе Debian 12 автозагрузку модулей ведёт systemd-udevd (через
# netlink uevent и libkmod), который сам очищает /proc/sys/kernel/hotplug после
# старта. Скрипт оставлен для ранней загрузки (до старта udevd) и rescue-режима.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

case "${ACTION:-${1:-}}" in
    add|ADD)
        [ -n "${MODALIAS:-}" ] || exit 0
        modprobe -q -a "$MODALIAS" 2>/dev/null || true
        ;;
esac

if [ "${SUBSYSTEM:-}" = block ] && [ "${ACTION:-}" = add ]; then
    modprobe -q -a exfat ntfs3 2>/dev/null || true
fi

exit 0
