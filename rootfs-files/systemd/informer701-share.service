[Unit]
Description=Informer 701 Windows-Compatible Shared SD Partition (/mnt/share)
DefaultDependencies=no
After=local-fs.target systemd-modules-load.service systemd-udevd.service
Before=multi-user.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/informer701-share-mount start
ExecStop=/usr/local/sbin/informer701-share-mount stop

[Install]
WantedBy=multi-user.target
