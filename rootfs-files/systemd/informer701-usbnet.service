[Unit]
Description=Informer 701 micro-USB Gadget Network (usb0 192.168.77.1)
After=systemd-udevd.service local-fs.target sys-kernel-config.mount
Wants=dropbear.service
ConditionKernelCommandLine=!usbnet=0
ConditionKernelCommandLine=!nousb=1

[Service]
Type=simple
ExecCondition=/usr/local/bin/usbnet check-autostart
ExecStart=/usr/local/bin/usbnet daemon
ExecStop=/usr/local/bin/usbnet off
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
